{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mac-cheatsheet-viewer",
  "version": "0.1.0",
  "identifier": "dev.macwm.mac-cheatsheet-viewer",
  "build": {
    "frontendDist": "../frontend/dist",
    "beforeDevCommand": "bash frontend/build.sh",
    "beforeBuildCommand": "bash frontend/build.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Paneru shortcuts",
        "width": 480,
        "height": 680,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}