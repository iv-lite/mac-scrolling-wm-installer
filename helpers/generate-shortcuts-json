#!/usr/bin/env python3
"""generate-shortcuts-json — read Nehir's `hotkeys.toml` and emit the
shortcut cheat-sheet JSON consumed by mac-cheatsheet-viewer.

The JSON goes to stdout by default; display-shortcuts writes it to
~/.config/nehir/cheatsheet.json and lets the viewer open it.

hotkeys.toml is flat `[section]` + `key = "Modifier+Combo"` lines (see
Sources/Nehir/Core/Config/HotkeysTOMLCodec.swift upstream) — this parses
it with regexes rather than a full TOML parser, same rationale as the
Rift-era version of this script: every binding here is a single-line
`key = "value"` entry (plus the `{N}` digit-group shorthand), which is
all this needs to handle. Unlike Rift's `config.toml`, there is no
`[modifier_combinations]` alias table — hotkeys.toml spells out
modifiers directly on every line.
"""
import argparse
import json
import os
import re
import sys

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

CONFIG_CANDIDATES = [
    os.path.join(os.environ.get("HOME", ""), ".config", "nehir", "hotkeys.toml"),
    os.path.join(REPO_ROOT, "config", "nehir", "hotkeys.toml"),
]

SECTION_RE = re.compile(r'^\s*\[([^\]]+)\]\s*$')
# key = "value"   (key may be a bare identifier or a quoted dotted key like
# "switch.3"); value runs to the closing quote.
KEY_LINE_RE = re.compile(r'^\s*"?([A-Za-z0-9_.]+)"?\s*=\s*"((?:[^"\\]|\\.)*)"\s*$')

# Curated (category, label) per "section.key". {n} expands a `{N}`-pattern
# value into one binding per digit 1-9. Unknown keys fall back to a
# title-cased guess from the key name, filed under a category named after
# the section.
LABELS = {
    "workspace.switch": ("Workspaces", "Switch to workspace {n}"),
    "workspace.moveTo": ("Workspaces", "Move window to workspace {n}"),
    "workspace.backAndForth": ("Workspaces", "Jump to last-focused workspace"),
    "workspace.next": ("Workspaces", "Next workspace"),
    "workspace.previous": ("Workspaces", "Previous workspace"),
    "focus.left": ("Focus", "Focus window left"),
    "focus.right": ("Focus", "Focus window right"),
    "focus.up": ("Focus", "Focus window up"),
    "focus.down": ("Focus", "Focus window down"),
    "focus.monitorNext": ("Displays", "Focus next display"),
    "focus.monitorPrevious": ("Displays", "Focus previous display"),
    "move.left": ("Move", "Move window left"),
    "move.right": ("Move", "Move window right"),
    "move.up": ("Move", "Move window up"),
    "move.down": ("Move", "Move window down"),
    "move.expelFromColumn": ("Move", "Un-join window from its column"),
    "layout.cycleColumnWidthForward": ("Column width", "Cycle column width forward (0.3/0.5/1.0)"),
    "layout.cycleColumnWidthBackward": ("Column width", "Cycle column width backward (0.3/0.5/1.0)"),
    "layout.toggleColumnFullWidth": ("Column width", "Jump to full width (stays tiled)"),
    "layout.toggleFocusedFloating": ("Window state", "Toggle floating / tiled"),
    "layout.toggleColumnTabbed": ("Window state", "Stack / unstack column"),
    "debugging.toggleTraceCapture": ("Misc", "Toggle debug trace capture"),
}

MOD_SYMBOLS = {
    "command": "Cmd", "option": "Option", "control": "Ctrl", "shift": "Shift",
    "hyper": "Hyper",
}

KEY_SYMBOLS = {
    "left arrow": "←", "right arrow": "→", "up arrow": "↑", "down arrow": "↓",
    "space": "Space", "tab": "Tab", "escape": "Esc", "return": "Return",
    "grave": "`", "period": ".", "comma": ",", "equal": "=", "minus": "-",
}


def humanize_chord(chord):
    parts = [p.strip() for p in chord.split("+") if p.strip()]
    if not parts:
        return chord
    *mods, raw_key = parts
    mod_labels = [MOD_SYMBOLS.get(m.lower(), m.capitalize()) for m in mods]
    key_label = KEY_SYMBOLS.get(raw_key.lower(), raw_key if len(raw_key) == 1 else raw_key.capitalize())
    return "+".join(mod_labels + [key_label])


def humanize_key_name(key):
    # camelCase -> "Title Case Words"
    words = re.findall(r'[A-Z]?[a-z0-9]+|[A-Z]+(?=[A-Z]|$)', key)
    return " ".join(w.capitalize() for w in words) if words else key


def parse_hotkeys(text):
    bindings = []  # (section, key, value)
    section = None
    for line in text.splitlines():
        sm = SECTION_RE.match(line)
        if sm:
            section = sm.group(1).strip()
            continue
        if section is None:
            continue
        km = KEY_LINE_RE.match(line)
        if km:
            bindings.append((section, km.group(1), km.group(2)))
    return bindings


def build_groups(bindings):
    groups = {}
    for section, key, value in bindings:
        if value == "Unassigned":
            continue
        lookup = "{}.{}".format(section, key)
        if "{N}" in value:
            category, template = LABELS.get(lookup, (section.capitalize(), humanize_key_name(key) + " {n}"))
            for n in range(1, 10):
                chord = value.replace("{N}", str(n))
                groups.setdefault(category, []).append(
                    {"action": template.format(n=n), "keys": [humanize_chord(chord)]}
                )
            continue
        category, label = LABELS.get(lookup, (section.capitalize(), humanize_key_name(key)))
        groups.setdefault(category, []).append({"action": label, "keys": [humanize_chord(value)]})

    static = [
        ("Gestures", [
            {"action": "Switch columns", "keys": ["3-finger swipe ←/→"]},
            {"action": "Switch workspaces", "keys": ["3-finger swipe ↑/↓"]},
        ]),
    ]
    for name, items in static:
        groups.setdefault(name, []).extend(items)
    return [{"name": name, "items": groups[name]} for name in groups]


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--config", help="path to Nehir's hotkeys.toml (default: ~/.config/nehir/hotkeys.toml)")
    ap.add_argument("--output", help="write JSON to this file instead of stdout")
    args = ap.parse_args()

    config = args.config
    if not config:
        config = next((c for c in CONFIG_CANDIDATES if os.path.isfile(c)), None)
    if not config or not os.path.isfile(config):
        sys.exit("generate-shortcuts-json: cannot find config/nehir/hotkeys.toml (use --config)")

    with open(config, encoding="utf-8") as fh:
        text = fh.read()
    bindings = parse_hotkeys(text)
    if not bindings:
        sys.exit("generate-shortcuts-json: no bindings found in {}".format(config))

    sheet = {
        "app": "Nehir",
        "config_path": os.path.abspath(config),
        "groups": build_groups(bindings),
    }

    if args.output:
        with open(args.output, "w", encoding="utf-8") as fh:
            json.dump(sheet, fh, ensure_ascii=False, indent=2)
            fh.write("\n")
    else:
        print(json.dumps(sheet, ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
