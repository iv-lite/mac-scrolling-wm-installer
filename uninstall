#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR" && pwd)"

GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
CYAN=$'\033[0;36m'
RED=$'\033[0;31m'
RESET=$'\033[0m'

note() { echo "  ${CYAN}→ $*${RESET}"; }
ok()   { echo "  ${GREEN}✓ $*${RESET}"; }
warn() { echo "  ${YELLOW}⚠ $*${RESET}"; }

echo ""
echo "  ╔══════════════════════════════════════════════════╗"
echo "  ║          niri-like macOS setup — uninstall        ║"
echo "  ╚══════════════════════════════════════════════════╝"
echo ""
echo "  This will:"
echo "   • Stop/remove Paneru (service + app launcher)"
echo "   • Revoke its Accessibility permission"
echo "   • Move configs to ~/.config/backups (not deleted, incl. shortcut helpers)"
echo "   • Remove Antigen shell setup (~/antigen.zsh, bundling, ~/.zshrc block)"
echo "   • Remove the paneru-swift + pq release binaries"
echo "     (and the legacy Rust paneru binary/app shim if still present)"
echo "   • Remove the tccutil-rs release binary"
echo "   • Uninstall brew packages (you'll choose which to keep)"
echo "     ghostty"
echo "   • Revert system defaults (show the native menu bar again)"
echo ""
read -r -p "  Continue? [y/N] " answer
if [ "${answer:-n}" != "y" ] && [ "${answer:-n}" != "Y" ]; then
	echo ""
	echo "  Aborted. Nothing was changed."
	exit 0
fi

# ─────────────────────────────────────────────────────────────
# 1. Stop & remove services
# ─────────────────────────────────────────────────────────────
echo ""
note "Stopping services..."

# The binary lives in the brew bin dir (already on PATH).
# Swift agent first (same stop semantics as upstream install-service.sh):
# boot out the service (else SIGTERM the job), then drop its plist.
# Both the current (iv-lite, upstream d04db61) and previous (karinushka)
# Swift labels are stopped/removed; the Rust agent is handled below.
SWIFT_LABEL="com.github.iv-lite.paneru-swift"
SWIFT_OLD_LABEL="com.github.karinushka.paneru.swift"
for _swift_label in "$SWIFT_LABEL" "$SWIFT_OLD_LABEL"; do
	if [ -f "$HOME/Library/LaunchAgents/$_swift_label.plist" ]; then
		launchctl bootout "gui/$(id -u)/$_swift_label" >/dev/null 2>&1 \
			|| launchctl kill SIGTERM "gui/$(id -u)/$_swift_label" >/dev/null 2>&1 || true
		rm -f "$HOME/Library/LaunchAgents/$_swift_label.plist"
		ok "Swift daemon agent stopped + removed ($_swift_label)"
	fi
done
if pgrep -qx paneru-swift >/dev/null 2>&1; then
	pkill -x paneru-swift >/dev/null 2>&1 || true
	ok "Swift daemon stopped"
fi
if command -v paneru >/dev/null 2>&1; then
	if paneru stop >/dev/null 2>&1; then
		ok "Legacy Rust daemon stopped"
	fi
	if paneru uninstall >/dev/null 2>&1; then
		ok "Legacy Rust service removed"
	fi
	if command -v paneru >/dev/null 2>&1; then
		paneru uninstall-app >/dev/null 2>&1 || true
		ok "Legacy Rust app launcher removed (if present)"
	fi
fi
# Belt-and-braces in case the CLI wasn't available to clean up after itself
if [ -f ~/Library/LaunchAgents/com.github.karinushka.paneru.plist ]; then
	launchctl bootout "gui/$(id -u)/com.github.karinushka.paneru" >/dev/null 2>&1 || true
	rm -f ~/Library/LaunchAgents/com.github.karinushka.paneru.plist
	ok "Paneru LaunchAgent stopped + removed (fallback)"
fi
if [ -d "$HOME/Applications/Paneru.app" ]; then
	rm -rf "$HOME/Applications/Paneru.app"
	ok "Removed ~/Applications/Paneru.app (fallback)"
fi

# ─────────────────────────────────────────────────────────────
# 2. Revoke Accessibility permissions
# ─────────────────────────────────────────────────────────────
echo ""
note "Revoking Accessibility permissions..."
if command -v tccutil-rs >/dev/null 2>&1; then
	revoked=0
	# Revoke both path-keyed and identifier-keyed rows (stable-identity
	# installs key on the identifier). The "Paneru Local" signing cert is
	# deliberately left in the keychain: it is long-lived and reinstalls
	# reuse it so the next grant stays sticky.
	for client in "$HOME/.local/bin/paneru" "$(command -v paneru 2>/dev/null || true)" \
		"$HOME/.local/bin/paneru-swift" "$(command -v paneru-swift 2>/dev/null || true)" \
		com.github.karinushka.paneru com.github.karinushka.paneru.swift com.github.iv-lite.paneru-swift; do
		if [ -n "$client" ]; then
			if [ -e "$client" ] || [[ "$client" == com.github.* ]]; then
				tccutil-rs revoke --user Accessibility "$client" >/dev/null 2>&1 || true
				revoked=1
			fi
		fi
	done
	if [ "$revoked" -eq 1 ]; then
		ok "Accessibility grant revoked (best-effort; signing cert kept for reinstalls)"
	else
		note "No Paneru binary found — nothing to revoke"
	fi
else
	note "tccutil-rs not installed — grants (if any) are left in place"
fi

# ─────────────────────────────────────────────────────────────
# 3. Remove configs (moved to backup, not destroyed)
# ─────────────────────────────────────────────────────────────
echo ""
note "Removing configs..."

BACKUP_DIR="$HOME/.config/backups/uninstall-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$BACKUP_DIR"

for dir in ~/.config/paneru ~/.config/mac-scrolling-wm ~/.config/ghostty; do
	if [ -d "$dir" ]; then
		mv "$dir" "$BACKUP_DIR/"
		ok "Moved $dir → $BACKUP_DIR/$(basename "$dir")"
	fi
done

# Antigen shell setup (installed by scripts/install-antigen): only our own
# bundling file, caches, and the marked ~/.zshrc block — anything else in
# ~/.config/zsh or ~/.zshrc is left alone.
if [ -f ~/.config/zsh/antigen.zsh ]; then
	mv ~/.config/zsh/antigen.zsh "$BACKUP_DIR/" 2>/dev/null && ok "Moved ~/.config/zsh/antigen.zsh → $BACKUP_DIR/"
fi
if [ -f ~/.zshrc ] && grep -qF "# >>> mac-scrolling-wm antigen >>>" ~/.zshrc 2>/dev/null; then
	cp ~/.zshrc ~/.zshrc.bak
	sed -i '' '/# >>> mac-scrolling-wm antigen >>>/,/# <<< mac-scrolling-wm antigen <<</d' ~/.zshrc
	ok "Removed Antigen block from ~/.zshrc (backed up to ~/.zshrc.bak)"
fi
for f in ~/antigen.zsh ~/.antigen; do
	if [ -e "$f" ]; then
		mv "$f" "$BACKUP_DIR/" 2>/dev/null && ok "Moved $f → $BACKUP_DIR/"
	fi
done

# Paneru single-file/state locations outside ~/.config
for f in ~/.paneru ~/.paneru.toml "$HOME/.local/state/paneru"; do
	if [ -e "$f" ]; then
		mv "$f" "$BACKUP_DIR/" 2>/dev/null && ok "Moved $f → $BACKUP_DIR/"
	fi
done
# XDG state home variant (Swift daemon honors $XDG_STATE_HOME, else
# ~/.local/state): move it too when it differs from the default above.
if [ -n "${XDG_STATE_HOME:-}" ] && [ "${XDG_STATE_HOME}/paneru" != "$HOME/.local/state/paneru" ]; then
	if [ -e "${XDG_STATE_HOME}/paneru" ]; then
		mv "${XDG_STATE_HOME}/paneru" "$BACKUP_DIR/" 2>/dev/null && ok "Moved ${XDG_STATE_HOME}/paneru → $BACKUP_DIR/"
	fi
fi
# Swift daemon live state + launchd logs (recreated on next install).
# Covers both the current (iv-lite) and previous (karinushka) Swift log
# names (the legacy shadow-mode state file is cleaned too, if any remains).
for f in /tmp/paneru-swift-state.json /tmp/paneru-swift-shadow.json "/tmp/${SWIFT_LABEL}_$(id -u).out.log" "/tmp/${SWIFT_LABEL}_$(id -u).err.log" "/tmp/${SWIFT_OLD_LABEL}_$(id -u).out.log" "/tmp/${SWIFT_OLD_LABEL}_$(id -u).err.log"; do
	if [ -e "$f" ]; then
		mv "$f" "$BACKUP_DIR/" 2>/dev/null && ok "Moved $f → $BACKUP_DIR/"
	fi
done

# Clean up backup dir if nothing was moved
if [ -z "$(ls -A "$BACKUP_DIR" 2>/dev/null)" ]; then
	rmdir "$BACKUP_DIR" 2>/dev/null || true
fi

# ─────────────────────────────────────────────────────────────
# 4. Uninstall brew packages + untaps (interactive keep menu)
# ─────────────────────────────────────────────────────────────
# Paneru itself is a direct binary in the brew bin dir (with
# ~/.local/bin/paneru as a fallback location), so remove the binary files
# themselves.
for paneru_bin_rm in "$(command -v paneru 2>/dev/null || true)" /opt/homebrew/bin/paneru /usr/local/bin/paneru "$HOME/.local/bin/paneru" "$(command -v paneru-swift 2>/dev/null || true)" /opt/homebrew/bin/paneru-swift /usr/local/bin/paneru-swift "$HOME/.local/bin/paneru-swift" "$(command -v pq 2>/dev/null || true)" /opt/homebrew/bin/pq /usr/local/bin/pq "$HOME/.local/bin/pq"; do
	if [ -n "$paneru_bin_rm" ] && [ -f "$paneru_bin_rm" ]; then
		rm -f "$paneru_bin_rm"
		ok "Removed Paneru binary $paneru_bin_rm"
	fi
done

# tccutil-rs is a direct release binary too (uinaf/tap dropped the formula),
# so remove the binary files themselves.
for tcc_bin_rm in "$(command -v tccutil-rs 2>/dev/null || true)" /opt/homebrew/bin/tccutil-rs /usr/local/bin/tccutil-rs "$HOME/.local/bin/tccutil-rs"; do
	if [ -n "$tcc_bin_rm" ] && [ -f "$tcc_bin_rm" ]; then
		rm -f "$tcc_bin_rm"
		ok "Removed tccutil-rs binary $tcc_bin_rm"
	fi
done

if command -v brew >/dev/null 2>&1; then
	echo ""
	note "Reviewing installed brew packages..."

	# Installed-package catalog: name, type, originating tap (if any)
	declare -a pkg_names pkg_types pkg_taps
	n=0
	add_pkg() {
		local name="$1" type="$2" tap="${3:-}"
		if brew list --"$type" "$name" >/dev/null 2>&1; then
			pkg_names[$n]="$name"
			pkg_types[$n]="$type"
			pkg_taps[$n]="$tap"
			n=$(( n + 1 ))
		fi
	}

	add_pkg ghostty      cask

	if [ "$n" -eq 0 ]; then
		note "No packages from this setup are installed — nothing to uninstall."
	else
		echo ""
		echo "  Installed packages from this setup:"
		i=0
		while [ "$i" -lt "$n" ]; do
			echo "    [$(( i + 1 ))] ${pkg_names[$i]}"
			i=$(( i + 1 ))
		done
		echo ""
		echo "  Enter the numbers you want to KEEP (space-separated,"
		read -r -p '  e.g. "1 2"), or press Enter to remove all: ' keep_answer

		# Normalize the answer into a guarded space-delimited set: " 1 3 "
		keep_set=""
		for num in ${keep_answer:-}; do
			case "$num" in
				''|*[!0-9]*) continue ;;
			esac
			if [ "$num" -ge 1 ] && [ "$num" -le "$n" ]; then
				keep_set="$keep_set $num"
			fi
		done
		keep_set=" $keep_set "

		echo ""
		i=0
		remove_taps=""
		while [ "$i" -lt "$n" ]; do
			num=$(( i + 1 ))
			name="${pkg_names[$i]}"
			type="${pkg_types[$i]}"
			tap="${pkg_taps[$i]}"
			if [[ " $keep_set " == *" $num "* ]]; then
				ok "Keeping $name"
			else
				if brew uninstall --"$type" "$name" >/dev/null 2>&1; then
					ok "Uninstalled $name"
				else
					warn "$name could not be uninstalled (best-effort)"
				fi
				if [ -n "$tap" ]; then
					case "$remove_taps" in
						*" $tap "*) ;;
						*) remove_taps="$remove_taps $tap " ;;
					esac
				fi
			fi
			i=$(( i + 1 ))
		done

		# Only untap repos whose packages were actually removed
		if [ -n "$remove_taps" ]; then
			for tap in $remove_taps; do
				brew untap "$tap" >/dev/null 2>&1 || true
				brew untrust "$tap" >/dev/null 2>&1 || true
			done
			ok "Brew taps removed (best-effort)"
		fi
	fi
else
	warn "brew not found — skipping package removal"
fi

# ─────────────────────────────────────────────────────────────
# 5. Revert system defaults
# ─────────────────────────────────────────────────────────────
echo ""
note "Reverting system defaults..."

# Show the native menu bar again
defaults write NSGlobalDomain _HIHideMenuBar -bool false 2>/dev/null || true

# Leave "Displays have separate Spaces" enabled (macOS default).
defaults write com.apple.spaces "spans-displays" -bool false 2>/dev/null || true
ok "System defaults reverted"

killall SystemUIServer 2>/dev/null || true
killall Finder 2>/dev/null || true

# ─────────────────────────────────────────────────────────────
# Summary
# ─────────────────────────────────────────────────────────────
echo ""
echo "  ${GREEN}══════════════════════════════════════════════════${RESET}"
echo "  ${GREEN}  Uninstall complete.${RESET}"
echo "  ${GREEN}══════════════════════════════════════════════════${RESET}"
echo ""
warn "A logout/login is advised for settings to fully revert."
echo ""
if [ -n "$(ls -A "$BACKUP_DIR" 2>/dev/null)" ]; then
	echo "  Configs backed up at: $BACKUP_DIR"
	echo "  (copy back to ~/.config to restore)"
fi