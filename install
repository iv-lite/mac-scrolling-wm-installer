#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR" && pwd)"

GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
CYAN=$'\033[0;36m'
RED=$'\033[0;31m'
RESET=$'\033[0m'

run_step() {
	local name="$1"
	echo ""
	echo "──────────────────────────────────────────────"
	echo "  ${CYAN}▶ ${name}${RESET}"
	echo "──────────────────────────────────────────────"
	bash "$REPO_ROOT/scripts/$name"
	local status=$?
	if [ $status -ne 0 ]; then
		echo ""
		echo "  ${RED}✗ '$name' failed (exit $status).${RESET}"
		exit 1
	fi
	echo "  ${GREEN}✓ done${RESET}"
}

for arg in "$@"; do
	case "$arg" in
		--help|-h)
			echo "Usage: ./install"
			echo ""
			echo "  Installs OmniWM + Ghostty with a niri-like sliding-strip"
			echo "  layout. Requires Apple Silicon + macOS 26+ (Tahoe)."
			exit 0
			;;
		-*)
			echo "Unknown option: $arg (run './install --help')" >&2
			exit 1
			;;
	esac
done

if [ -d /Applications/OmniWM.app ] || [ -d ~/.config/omniwm ]; then
	MODE="upgrade"
else
	MODE="install"
fi

echo ""
echo "  ╔══════════════════════════════════════════════════════╗"
echo "  ║   OmniWM + Ghostty installer                        ║"
if [ "$MODE" = "upgrade" ]; then
	echo "  ║              niri-like macOS setup (upgrade)       ║"
else
	echo "  ║              niri-like macOS setup                 ║"
fi
echo "  ╚══════════════════════════════════════════════════════╝"

run_step install-deps
run_step configure-system
run_step install-ghostty
run_step install-omniwm
run_step grant-permissions
run_step enable-services

echo ""
echo "  ${GREEN}══════════════════════════════════════════════${RESET}"
if [ "$MODE" = "upgrade" ]; then
	echo "  ${GREEN}  Upgrade complete — configs refreshed & service restarted${RESET}"
	echo "  ${GREEN}  (OmniWM, Ghostty)${RESET}"
else
	echo "  ${GREEN}  Installation complete!${RESET}"
fi
echo "  ${GREEN}══════════════════════════════════════════════${RESET}"
echo ""
if [ "$MODE" = "upgrade" ]; then
	echo "  ${YELLOW}⚠ No logout needed for this upgrade.${RESET}"
	echo "     (A logout is only required if you toggled 'Displays have separate Spaces'.)"
else
	echo "  ${YELLOW}⚠ A logout/login is required for this to take effect:${RESET}"
	echo "     - 'Displays have separate Spaces' enabled (OmniWM requires it)"
fi
echo ""
if [ "$MODE" = "upgrade" ]; then
	echo "  ${YELLOW}⚠ Running now:${RESET}"
else
	echo "  ${YELLOW}⚠ After the next login:${RESET}"
fi
echo "     - OmniWM tiles windows in niri-style horizontal strips"
echo "     - OmniWM pops up the active workspace on switch"
echo "     - Ghostty runs frameless (title bar hidden)"
echo "     - IPC enabled — run omniwmctl to inspect the live state"
echo "     - If accessibility/input grants failed above, grant them manually:"
echo "       System Settings → Privacy & Security → Accessibility + Input Monitoring"
echo ""
echo "  ${CYAN}Keybindings:${RESET}"
echo "     Cmd+Arrows                  move focus"
echo "     Cmd+Shift+Arrows            move windows"
echo "     Cmd+Option+↑/↓              next/previous workspace on this display"
echo "     Cmd+Option+Shift+↑/↓        move window to next/previous workspace"
echo "     Cmd+Ctrl+Arrows             move workspace between displays"
echo "     Cmd+Ctrl+Shift+Arrows       move window between displays"
echo "     Cmd+Option+W                cycle column width (0.3 / 0.5 / 1)"
echo "     Cmd+Option+M                toggle full-width"
echo "     Cmd+Option+V                toggle floating"
echo "     Cmd+Option+B                balance sizes"
echo "     Cmd+Option+Space            center column"
echo "     Cmd+Option+Tab              focus previous window"
echo "     3-finger vertical swipe     switch workspaces"
echo "     Click inactive window       focus it (focus follows mouse)"
echo ""
echo "  ${CYAN}Workspaces:${RESET}"
echo "     Dynamic — workspaces appear on demand and vanish when empty."
echo "     Each display seeds one workspace (main '1', second '10');"
echo "     Cmd+Option+↑/↓ navigates the current display's stack."
echo "     Left/right arrows handle windows; the numeric keys are unused."
echo ""
if [ "$MODE" = "upgrade" ]; then
	echo "  'Displays have separate Spaces' is already configured; no logout required."
else
	echo "  Log out now, then back in (Cmd+Shift+Q)."
fi