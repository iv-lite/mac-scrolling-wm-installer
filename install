#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR" && pwd)"

GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
CYAN=$'\033[0;36m'
RED=$'\033[0;31m'
RESET=$'\033[0m'

run_step() {
	local name="$1"
	echo ""
	echo "──────────────────────────────────────────────"
	echo "  ${CYAN}▶ ${name}${RESET}"
	echo "──────────────────────────────────────────────"
	bash "$REPO_ROOT/scripts/$name"
	local status=$?
	if [ $status -ne 0 ]; then
		echo ""
		echo "  ${RED}✗ '$name' failed (exit $status).${RESET}"
		exit 1
	fi
	echo "  ${GREEN}✓ done${RESET}"
}

# ─────────────────────────────────────────────────────────────
# Flags: --help
# ─────────────────────────────────────────────────────────────
for arg in "$@"; do
	case "$arg" in
		--help|-h)
			echo "Usage: ./install"
			echo ""
			echo "  Installs Nehir + JankyBorders + Ghostty with an niri-like"
			echo "  scrolling-strip layout (no flags currently)."
			exit 0
			;;
		-*)
			echo "Unknown option: $arg (run './install --help')" >&2
			exit 1
			;;
	esac
done

# Fresh install vs. upgrade of an existing setup
if [ -d /Applications/Nehir.app ]; then
	MODE="upgrade"
else
	MODE="install"
fi

echo ""
echo "  ╔══════════════════════════════════════════════════════╗"
echo "  ║   Nehir + JankyBorders + Ghostty installer           ║"
if [ "$MODE" = "upgrade" ]; then
	echo "  ║              niri-like macOS setup (upgrade)       ║"
else
	echo "  ║              niri-like macOS setup                 ║"
fi
echo "  ╚══════════════════════════════════════════════════════╝"

run_step install-deps
run_step configure-system
run_step install-ghostty
run_step install-nehir
run_step install-borders
run_step install-helpers
run_step grant-permissions
run_step enable-services

echo ""
echo "  ${GREEN}══════════════════════════════════════════════${RESET}"
if [ "$MODE" = "upgrade" ]; then
	echo "  ${GREEN}  Upgrade complete — configs refreshed & services restarted${RESET}"
	echo "  ${GREEN}  (Nehir, JankyBorders, Ghostty)${RESET}"
else
	echo "  ${GREEN}  Installation complete!${RESET}"
fi
echo "  ${GREEN}══════════════════════════════════════════════${RESET}"
echo "  ${YELLOW}⚠ Running now (no logout required):${RESET}"
echo "     - Nehir tiles windows on a niri-style scrolling strip"
echo "     - Nehir's native menu bar shows workspaces 1-9"
echo "     - JankyBorders draws a border around the focused window"
echo "     - Moving the mouse to a display's edge warps it to the next"
echo "       monitor, cycling — native to Nehir, no extra process needed"
echo "     - Ghostty runs frameless (title bar hidden)"
echo "     - If the Accessibility grant failed above, grant it manually:"
echo "       System Settings → Privacy & Security → Accessibility → Nehir"
echo "     - Nehir has no 'start at login' toggle of its own — add it once:"
echo "       System Settings → General → Login Items & Extensions → '+' → Nehir"
echo ""
echo "  ${CYAN}Usage:${RESET}"
echo "     Option+Cmd+Arrows          move focus between windows"
echo "     3-finger swipe (←/→)       switch columns"
echo "     3-finger swipe (↑/↓)       switch workspaces"
echo "     Option+Cmd+Shift+Arrows    move windows"
echo "     Ctrl+Option+↑/↓            previous/next workspace"
echo "     Option+Cmd+1..9            switch to workspace 1-9"
echo "     Option+Cmd+Shift+1..9      move window to workspace 1-9"
echo "     Option+Cmd+W / Shift+W     cycle column width (0.3/0.5/1.0)"
echo "     Option+Cmd+M               jump to full width (stays tiled)"
echo "     Option+Cmd+V               toggle floating"
echo "     Option+Cmd+O               stack / unstack column"
echo "     Ctrl+Cmd+Left/Right        focus previous/next display"
echo ""
echo "  See README.md for the full keybinding table, including bindings that"
echo "  changed or were dropped moving from Rift's exec-based config to"
echo "  Nehir's fixed native action catalog."