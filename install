#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR" && pwd)"

GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
CYAN=$'\033[0;36m'
RED=$'\033[0;31m'
RESET=$'\033[0m'

run_step() {
	local name="$1"
	echo ""
	echo "──────────────────────────────────────────────"
	echo "  ${CYAN}▶ ${name}${RESET}"
	echo "──────────────────────────────────────────────"
	bash "$REPO_ROOT/scripts/$name"
	local status=$?
	if [ $status -ne 0 ]; then
		echo ""
		echo "  ${RED}✗ '$name' failed (exit $status).${RESET}"
		exit 1
	fi
	echo "  ${GREEN}✓ done${RESET}"
}

# ─────────────────────────────────────────────────────────────
# Flags: --help
# ─────────────────────────────────────────────────────────────
for arg in "$@"; do
	case "$arg" in
		--help|-h)
			echo "Usage: ./install"
			echo ""
			echo "  Installs Paneru + Ghostty with an niri-like sliding-strip"
			echo "  layout (no flags currently)."
			exit 0
			;;
		-*)
			echo "Unknown option: $arg (run './install --help')" >&2
			exit 1
			;;
	esac
done

# Fresh install vs. upgrade of an existing setup
if command -v paneru >/dev/null 2>&1; then
	MODE="upgrade"
else
	MODE="install"
fi

echo ""
echo "  ╔══════════════════════════════════════════════════════╗"
echo "  ║   Paneru + Ghostty installer                        ║"
if [ "$MODE" = "upgrade" ]; then
	echo "  ║              niri-like macOS setup (upgrade)       ║"
else
	echo "  ║              niri-like macOS setup                 ║"
fi
echo "  ╚══════════════════════════════════════════════════════╝"

run_step install-deps
run_step configure-system
run_step install-ghostty
run_step install-antigen
run_step install-paneru
run_step install-helpers
run_step grant-permissions
run_step enable-services

echo ""
echo "  ${GREEN}══════════════════════════════════════════════${RESET}"
if [ "$MODE" = "upgrade" ]; then
	echo "  ${GREEN}  Upgrade complete — configs refreshed & service restarted${RESET}"
	echo "  ${GREEN}  (Paneru, Ghostty)${RESET}"
else
	echo "  ${GREEN}  Installation complete!${RESET}"
fi
echo "  ${GREEN}══════════════════════════════════════════════${RESET}"
echo ""
if [ "$MODE" = "upgrade" ]; then
	echo "  ${YELLOW}⚠ No logout needed for this upgrade.${RESET}"
	echo "     (A logout is only required if you toggled 'Displays have separate Spaces'.)"
else
	echo "  ${YELLOW}⚠ A logout/login is required for this to take effect:${RESET}"
	echo "     - 'Displays have separate Spaces' enabled (Paneru-recommended)"
fi
echo ""
if [ "$MODE" = "upgrade" ]; then
	echo "  ${YELLOW}⚠ Running now:${RESET}"
else
	echo "  ${YELLOW}⚠ After the next login:${RESET}"
fi
echo "     - Paneru tiles windows on niri-style horizontal strips"
echo "     - Paneru pops up the active workspace on switch"
echo "     - Ghostty runs frameless (title bar hidden)"
echo "     - If accessibility grants failed above, grant them manually:"
echo "       System Settings → Privacy & Security → Accessibility"
echo ""
echo "  ${CYAN}Usage:${RESET}"
echo "     Cmd+Option+Arrows        move focus between windows"
echo "     3-finger swipe (←/→)     page through windows (full-width)"
echo "     3-finger swipe (↑/↓)     switch virtual workspaces"
echo "     Cmd+Option+Shift+Arrows  move windows"
echo "     Ctrl+Option+↑/↓          switch virtual workspace (dynamic rows)"
echo "     Ctrl+Option+Shift+↑/↓    move window to workspace"
echo "     Cmd+Option+W             cycle column width (0.3 / 0.5 / 1)"
echo "     Cmd+Option+V             toggle floating"
echo "     Cmd+Option+O             stack / unstack"
echo "     Cmd+Ctrl+Arrows              focus previous/next display"
echo "     Cmd+Ctrl+Shift+Arrows        move window to display (follow)"
echo "     Cmd+Ctrl+Alt+Arrows          send window to display (stay)"
echo "     Cmd+Ctrl+↑/↓                 warp mouse to next/previous display"
echo "     Cmd+Option+Shift+R       restart Paneru (config live-reloads anyway)"
echo "     Cmd+Shift+?              show the shortcut cheat sheet"
echo ""
if [ "$MODE" = "upgrade" ]; then
	echo "  'Displays have separate Spaces' is already configured; no logout required."
else
	echo "  Log out now, then back in (Cmd+Shift+Q)."
fi