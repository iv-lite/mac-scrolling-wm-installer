# Ghostty config — frameless niri-style terminal.
# Generated by paneru-wm-installer. Edit freely.
#
# Hidden titlebar keeps rounded corners/borders without the title chrome.
# Window dragging falls back to Option+Click on the frame (standard macOS).
macos-window-buttons = hidden

shell-integration = detect
shell-integration-features = cursor,sudo,title
quit-after-last-window-closed=true