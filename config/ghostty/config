# Ghostty config — frameless niri-style terminal.
# Generated by nehir-wm-installer. Edit freely.
#
# Hidden titlebar keeps rounded corners/borders without the title chrome.
# Window dragging falls back to Option+Click on the frame (standard macOS).
macos-titlebar-style = hidden
macos-window-buttons = hidden

mouse-hide-while-typing = true

window-padding-x = 2
window-padding-y = 2
window-padding-balance = true

scrollback-limit = 100000000

shell-integration = detect
shell-integration-features = cursor,sudo,title
quit-after-last-window-closed=true