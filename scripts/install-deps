#!/usr/bin/env bash
set -euo pipefail

GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
CYAN=$'\033[0;36m'
RED=$'\033[0;31m'
RESET=$'\033[0m'

note()  { echo "  ${CYAN}→ $*${RESET}"; }
ok()    { echo "  ${GREEN}✓ $*${RESET}"; }
warn()  { echo "  ${YELLOW}⚠ $*${RESET}"; }
fail()  { echo "  ${RED}✗ $*${RESET}"; }

# ─────────────────────────────────────────────────────────────
# Homebrew
# ─────────────────────────────────────────────────────────────
if ! command -v brew >/dev/null 2>&1; then
	note "Homebrew not found. Installing..."
	NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
	if [ -x /opt/homebrew/bin/brew ]; then
		eval "$(/opt/homebrew/bin/brew shellenv)"
	elif [ -x /usr/local/bin/brew ]; then
		eval "$(/usr/local/bin/brew shellenv)"
	else
		fail "Homebrew installed but 'brew' not on PATH. Add it and re-run."
		exit 1
	fi
	ok "Homebrew installed"
else
	ok "Homebrew already installed"
fi

command -v brew >/dev/null 2>&1 || eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null || true)"
command -v brew >/dev/null 2>&1 || eval "$(/usr/local/bin/brew shellenv 2>/dev/null || true)"

# ─────────────────────────────────────────────────────────────
# tccutil-rs (user TCC db grants, no SIP disable needed)
# ─────────────────────────────────────────────────────────────
if command -v tccutil-rs >/dev/null 2>&1; then
	note "Upgrading tccutil-rs..."
	brew upgrade tccutil-rs 2>/dev/null || warn "tccutil-rs upgrade failed (network?) — keeping installed version"
	ok "tccutil-rs up to date"
else
	note "Installing tccutil-rs from uinaf/tap..."
	brew trust uinaf/tap 2>/dev/null || true
	brew tap uinaf/tap
	brew install tccutil-rs
	ok "tccutil-rs installed"
fi

# ─────────────────────────────────────────────────────────────
# TCC preflight: stale Paneru grants can only be removed while this
# terminal has Full Disk Access — macOS blocks TCC.db reads and writes
# otherwise, and even sudo cannot bypass it. Probe now, before any binary
# is replaced, so an upgrade without FDA is a conscious choice rather
# than a silent leftover (install-paneru verifies removal again later).
# Never fatal: without FDA the installer falls back to loud warnings
# plus manual removal steps.
# ─────────────────────────────────────────────────────────────
if command -v paneru >/dev/null 2>&1 && command -v tccutil-rs >/dev/null 2>&1; then
	if ! tccutil-rs list --service Accessibility >/dev/null 2>&1; then
		warn "This terminal cannot read the TCC database (no Full Disk Access) —"
		warn "the existing Paneru Accessibility grant can NOT be removed programmatically."
		echo "     Before upgrading: either grant this terminal Full Disk Access"
		echo "     (System Settings → Privacy & Security → Full Disk Access, then fully"
		echo "     quit and reopen the terminal and re-run ./install), or delete the old"
		echo "     Paneru entry by hand (System Settings → Privacy & Security →"
		echo "     Accessibility → select 'paneru' → '–'), then re-run."
	fi
fi

echo ""
ok "Dependencies ready"
