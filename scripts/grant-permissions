#!/usr/bin/env bash
set -euo pipefail

CYAN=$'\033[0;36m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
RED=$'\033[0;31m'
RESET=$'\033[0m'

note() { echo "  ${CYAN}→ $*${RESET}"; }
ok()   { echo "  ${GREEN}✓ $*${RESET}"; }
warn() { echo "  ${YELLOW}⚠ $*${RESET}"; }
fail() { echo "  ${RED}✗ $*${RESET}"; }

OMNIWM_APP="/Applications/OmniWM.app"

if [ ! -d "$OMNIWM_APP" ]; then
	fail "OmniWM is not installed at $OMNIWM_APP — run scripts/install-omniwm first"
	exit 1
fi

# ─────────────────────────────────────────────────────────────
# Accessibility — grant to the OmniWM app bundle.
#  1. user DB via tccutil-rs (no sudo, no SIP disable)
#  2. system DB with sudo as fallback
#  3. manual instructions as last resort
# ─────────────────────────────────────────────────────────────
note "Granting Accessibility to OmniWM..."

if command -v tccutil-rs >/dev/null 2>&1; then
	if tccutil-rs grant --user Accessibility "$OMNIWM_APP" >/dev/null 2>&1; then
		ok "Accessibility granted to OmniWM (user db)"
	elif sudo -n tccutil-rs grant Accessibility "$OMNIWM_APP" >/dev/null 2>&1; then
		ok "Accessibility granted to OmniWM (system db via sudo)"
	else
		fail "Could not grant Accessibility to OmniWM automatically."
		echo "     Grant manually: System Settings → Privacy & Security →"
		echo "     Accessibility → '+' → add OmniWM.app"
	fi
else
	fail "tccutil-rs not found — install it (brew install tccutil-rs) and re-run."
	echo "     Manual fallback: System Settings → Privacy & Security →"
	echo "     Accessibility → '+' → add OmniWM.app"
fi

# ─────────────────────────────────────────────────────────────
# Input Monitoring — cannot be granted programmatically; the
# switch must be toggled once by hand.
# ─────────────────────────────────────────────────────────────
note "Input Monitoring must be enabled manually (macOS enforces this)."
echo "     Opening Input Monitoring settings..."
open "x-apple.systempreferences:com.apple.preference.security?Privacy_ListenEvent"
warn "Toggle 'OmniWM' ON in the Input Monitoring list, then re-run: bash scripts/enable-services"

# ─────────────────────────────────────────────────────────────
# Post-grant verification (requires Full Disk Access on the
# terminal app for tccutil-rs to read TCC.db).
# ─────────────────────────────────────────────────────────────
note "Verifying grants (requires Full Disk Access on the host terminal)..."
if command -v tccutil-rs >/dev/null 2>&1; then
	if tccutil-rs list --user --service Accessibility 2>/dev/null | grep -qF "$OMNIWM_APP"; then
		ok "OmniWM found in Accessibility list (user db)"
	elif tccutil-rs list --service Accessibility 2>/dev/null | grep -qF "$OMNIWM_APP"; then
		ok "OmniWM found in Accessibility list (system db)"
	else
		warn "OmniWM not visible in the Accessibility list"
		echo "     If the terminal app lacks Full Disk Access, verification is"
		echo "     unreliable — the grant may still have succeeded."
	fi
else
	warn "tccutil-rs not found — skipping verification"
fi

warn "If grants failed: the terminal app running this installer needs"
echo "     'Full Disk Access' (System Settings → Privacy & Security → Full Disk Access),"
echo "     then quit and reopen the terminal and re-run: bash scripts/grant-permissions"

echo ""
ok "Permission grants finished"