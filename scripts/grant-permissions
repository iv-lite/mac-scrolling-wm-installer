#!/usr/bin/env bash
set -euo pipefail

CYAN=$'\033[0;36m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
RED=$'\033[0;31m'
RESET=$'\033[0m'

note() { echo "  ${CYAN}→ $*${RESET}"; }
ok()   { echo "  ${GREEN}✓ $*${RESET}"; }
warn() { echo "  ${YELLOW}⚠ $*${RESET}"; }
fail() { echo "  ${RED}✗ $*${RESET}"; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/swift-common.sh
source "$SCRIPT_DIR/lib/swift-common.sh"

# ─────────────────────────────────────────────────────────────
# Grant Accessibility to CLI binaries (invisible in System Settings)
# -1. no-FDA handoff: without Full Disk Access no scripted TCC write can
#     succeed, so skip them all and hand off to the daemon's native dialog
# 1. grant-if-missing: with the persistent signing identity from
#     scripts/ensure-signing-identity (stable identifier+certificate DR),
#     rebuilds keep the same TCC identity, so an existing row stays valid
#     and must NOT be revoked. Only grant when neither the binary path nor
#     the signing identifier is listed.
# 2. user DB via tccutil-rs (no sudo, no SIP disable)
# 3. system DB with sudo as fallback
# 4. manual instructions as last resort
# Revokes happen only reactively: repair-paneru sets PANERU_GRANT_REVOKE=1
# when the enable-services health poll fails (listed-but-dead grant).
# revoke_stale() below serves that path only.
# ─────────────────────────────────────────────────────────────
revoke_stale() {
	local bin="$1" revoke_err before_list client idclient="${2:-$PANERU_IDENTIFIER}"
	if [ -z "$bin" ]; then return 0; fi
	if [ ! -e "$bin" ]; then return 0; fi
	if ! command -v tccutil-rs >/dev/null 2>&1; then return 0; fi
	# Best-effort and never fatal, but loud when there is evidence of a
	# leftover: a clean client with no entry fails revokes by design, so
	# only report when the entry was actually there. A revoke that fails
	# usually means this terminal lacks Full Disk Access (fully quit +
	# reopen the terminal after granting it). Clients cover both TCC key
	# forms: the binary path and the signing identifier.
	before_list="$(tccutil-rs list --service Accessibility 2>&1 || true)"
	for client in "$bin" "$idclient"; do
		if revoke_err="$(tccutil-rs revoke --user Accessibility "$client" 2>&1)"; then
			if printf '%s' "$before_list" | grep -qF "$client"; then
				note "Revoked stale Accessibility grant for $client (user db)"
			fi
		elif printf '%s' "$before_list" | grep -qF "$client"; then
			warn "Could not revoke stale Accessibility grant for $client (user db): $revoke_err"
		fi
		if revoke_err="$(sudo -n tccutil-rs revoke Accessibility "$client" 2>&1)"; then
			if printf '%s' "$before_list" | grep -qF "$client"; then
				note "Revoked stale Accessibility grant for $client (system db)"
			fi
		elif printf '%s' "$before_list" | grep -qF "$client"; then
			warn "Could not revoke stale Accessibility grant for $client (system db): $revoke_err"
			# The non-interactive attempt fails without passwordless sudo —
			# on a TTY offer one interactive retry so a system-db leftover
			# still has a programmatic path (skipped in CI/VM runs).
			if [ -t 0 ]; then
				note "Retrying the system-db revoke with an interactive sudo prompt..."
				if revoke_err="$(sudo tccutil-rs revoke Accessibility "$client" 2>&1)"; then
					note "Revoked stale Accessibility grant for $client (system db)"
				else
					warn "Interactive sudo revoke failed too: $revoke_err"
				fi
			fi
		fi
	done
}

# Signing identifier stamped onto the binary (the same one install-paneru
# signs with). TCC rows may be keyed by the binary path or the identifier.
PANERU_SWIFT_IDENTIFIER="$PANERU_SWIFT_LABEL"

grant_present() {
	local bin="$1" identifier="${2:-}"
	local list
	if ! command -v tccutil-rs >/dev/null 2>&1; then return 1; fi
	list="$(tccutil-rs list --service Accessibility 2>&1 || true)"
	if [ -n "$bin" ] && printf '%s' "$list" | grep -qF "$bin"; then return 0; fi
	if [ -n "$identifier" ] && printf '%s' "$list" | grep -qF "$identifier"; then return 0; fi
	return 1
}

grant() {
	local bin="$1" identifier="${2:-}" force="${3:-0}"
	if [ -z "$bin" ]; then return 0; fi
	if [ ! -e "$bin" ]; then
		warn "$bin not found — skipping"
		return 0
	fi
	# No-FDA handoff: without Full Disk Access this terminal can neither
	# read nor write TCC.db (even sudo cannot bypass it), so every scripted
	# revoke/grant below is doomed — attempting them only produces walls of
	# failure noise. Skip them all and hand off to the daemon's native flow
	# instead: enable-services (next step) starts Paneru, which parks with a
	# setup dialog and waits; flipping the toggle in System Settings
	# replaces a stale row itself.
	if command -v tccutil-rs >/dev/null 2>&1 && ! tccutil-rs list --service Accessibility >/dev/null 2>&1; then
		note "No Full Disk Access for this terminal — skipping scripted grants entirely."
		echo "     macOS blocks TCC.db reads and writes without it; revoke/grant"
		echo "     commands would only fail. enable-services (next) starts Paneru,"
		echo "     which shows a setup dialog and waits: flip the toggle in"
		echo "     System Settings → Privacy & Security → Accessibility and tiling"
		echo "     starts. Only if Paneru is already listed-but-dead, remove it"
		echo "     with '–' first, then toggle it back on."
		return 0
	fi
	# Sticky grants: skip everything when a row already exists for this
	# binary path or its signing identifier. Revokes happen only on the
	# repair path (PANERU_GRANT_REVOKE=1 from repair-paneru). Forced
	# grants (unstamped legacy installs) always run the commands once
	# so a dead-but-string-matched row can't bless a broken binary.
	if [ "$force" != 1 ] && grant_present "$bin" "$identifier"; then
		ok "Accessibility grant already present for $bin — keeping (no revoke)"
		return 0
	fi
	if [ "${PANERU_GRANT_REVOKE:-0}" = "1" ]; then
		revoke_stale "$bin"
	fi
	if command -v tccutil-rs >/dev/null 2>&1; then
		if tccutil-rs grant --user Accessibility "$bin" >/dev/null 2>&1; then
			ok "Accessibility granted to $bin (user db)"
			if [ -n "$identifier" ]; then
				tccutil-rs grant --user Accessibility "$identifier" >/dev/null 2>&1 || true
			fi
			return 0
		fi
		sudo -n tccutil-rs grant Accessibility "$bin" >/dev/null 2>&1 && {
			ok "Accessibility granted to $bin (system db via sudo)"
			if [ -n "$identifier" ]; then
				sudo -n tccutil-rs grant Accessibility "$identifier" >/dev/null 2>&1 || true
			fi
			return 0
		}
	fi
	fail "Could not grant Accessibility to $bin automatically."
	echo "     Grant manually: System Settings → Privacy & Security →"
	echo "     Accessibility → '+' → add '$bin'"
}

note "Granting Accessibility permissions..."

# The installed paneru-swift binary (on PATH — install-paneru puts it in
# the brew bin dir). A leftover copy elsewhere is granted too when it
# exists, so a PATH shadow can never keep an ungranted identity alive.
SWIFT_BIN="$(find_installed_bin paneru-swift || true)"
if [ -n "$SWIFT_BIN" ]; then
	# Install-identity drift (rebuild, rename, move, cert rotation):
	# existing TCC rows were cut for a different binary identity and a
	# string match below would bless them falsely. Revoke the stale
	# identifier row when we know it; never revoke blind (a failed
	# re-grant must not destroy a working grant). Missing stamp =
	# legacy install: full grant flow, no revokes.
	force=0
	if swift_stamp_drifted "$SWIFT_BIN"; then
		old_id="$(swift_stamp_field 1 || true)"
		if [ -s "$PANERU_SWIFT_STAMP" ] && [ -n "$old_id" ] && [ "$old_id" != "$PANERU_SWIFT_IDENTIFIER" ]; then
			note "Swift install identity changed ($old_id → $PANERU_SWIFT_IDENTIFIER) — revoking the stale identifier row"
			revoke_stale "$SWIFT_BIN" "$old_id"
		elif [ ! -s "$PANERU_SWIFT_STAMP" ]; then
			note "No Swift install stamp (legacy install) — forcing one full grant, no revokes"
			force=1
		else
			note "Swift binary drifted since install (rebuild/move/cert) — existing TCC rows can't be trusted; forcing grant flow"
		fi
	else
		force=0
	fi
	# Trust override: a string-matched row can still be dead when the
	# signature no longer verifies (the signing cert was removed or
	# rotated while the stamp's cdhash/authority happened to match), which
	# leaves the daemon answering queries but denied every AX write.
	# Force the revoke + re-grant regardless of stamp agreement.
	if ! swift_signature_trusted "$SWIFT_BIN"; then
		note "Swift signature does not verify (stale/untrusted cert) — forcing revoke + re-grant"
		force=1
		revoke_stale "$SWIFT_BIN"
	fi
	grant "$SWIFT_BIN" "$PANERU_SWIFT_IDENTIFIER" "$force"
	# Record the granted identity so the next run detects drift. (A
	# forced grant that actually failed stays visible: the AX gate in
	# enable-services proves the write path at runtime.)
	swift_write_stamp "$SWIFT_BIN"
fi
# Note: `pq` is deliberately never granted — it holds no event tap and
# only talks to the daemon over XPC, so it needs no Accessibility row.

# ─────────────────────────────────────────────────────────────
# Post-grant verification: check the TCC database via tccutil-rs
# list (requires Full Disk Access for the host terminal app).
# ─────────────────────────────────────────────────────────────
note "Verifying grants (requires Full Disk Access on the host terminal)..."
verify_grant() {
	local bin="$1" identifier="${2:-}"
	if [ -z "$bin" ] || [ ! -e "$bin" ]; then
		return 0
	fi
	# --service filters by TCC service; --user reads per-user DB first
	# (covers the common grant path; system DB grants need sudo list).
	# A row keyed by either the binary path or the signing identifier
	# counts as present (stable-identity installs key on the latter).
	if tccutil-rs list --user --service Accessibility 2>/dev/null | grep -qF "$bin"; then
		ok "$bin found in Accessibility list (user db)"
	elif [ -n "$identifier" ] && tccutil-rs list --user --service Accessibility 2>/dev/null | grep -qF "$identifier"; then
		ok "$identifier found in Accessibility list (user db)"
	elif tccutil-rs list --service Accessibility 2>/dev/null | grep -qF "$bin"; then
		ok "$bin found in Accessibility list (system db)"
	elif [ -n "$identifier" ] && tccutil-rs list --service Accessibility 2>/dev/null | grep -qF "$identifier"; then
		ok "$identifier found in Accessibility list (system db)"
	else
		warn "$bin not visible in Accessibility list"
		echo "     If the terminal app lacks Full Disk Access, verification is"
		echo "     unreliable — the grant may still have succeeded."
	fi
}

if command -v tccutil-rs >/dev/null 2>&1; then
	if [ -n "${SWIFT_BIN:-}" ]; then
		verify_grant "$SWIFT_BIN" "$PANERU_SWIFT_IDENTIFIER"
	fi
else
	warn "tccutil-rs not found — skipping verification"
fi

# The terminal itself needs Full Disk Access for tccutil-rs to open TCC.db.
warn "If grants failed: the terminal app running this installer needs"
echo "     'Full Disk Access' (System Settings → Privacy & Security → Full Disk Access),"
echo "     then quit and reopen the terminal and re-run: bash scripts/grant-permissions"

# Restart tccd so any grants are picked up by running processes without waiting.
if command -v tccutil-rs >/dev/null 2>&1; then
	sudo -n launchctl stop com.apple.tccd >/dev/null 2>&1 || true
fi

echo ""
ok "Permission grants finished"