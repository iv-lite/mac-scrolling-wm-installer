#!/usr/bin/env bash
set -euo pipefail

CYAN=$'\033[0;36m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
RESET=$'\033[0m'

note() { echo "  ${CYAN}→ $*${RESET}"; }
ok()   { echo "  ${GREEN}✓ $*${RESET}"; }
warn() { echo "  ${YELLOW}⚠ $*${RESET}"; }
fail() { echo "  ${RED}✗ $*${RESET}"; exit 1; }

LAUNCH_AGENT="$HOME/Library/LaunchAgents/dev.guria.nehir.plist"
LABEL="dev.guria.nehir"

# Resolve the app path — cask installs to /Applications, source to ~/Applications.
app_path() {
	if [ -d /Applications/Nehir.app ]; then
		echo "/Applications/Nehir.app"
	elif [ -d "$HOME/Applications/Nehir.app" ]; then
		echo "$HOME/Applications/Nehir.app"
	else
		echo ""
	fi
}

if [ -z "$(app_path)" ]; then
	fail "Nehir.app not found at /Applications or ~/Applications — run scripts/install-nehir first"
fi

# ─────────────────────────────────────────────────────────────
# Accessibility — grant to the Nehir app bundle.
#  1. user DB via tccutil-rs (no sudo, no SIP disable)
#  2. system DB with sudo as fallback
#  3. manual instructions as last resort
# ─────────────────────────────────────────────────────────────
NHEIR_APP="$(app_path)"
note "Granting Accessibility to Nehir ($NHEIR_APP)..."

if command -v tccutil-rs >/dev/null 2>&1; then
	if tccutil-rs grant --user Accessibility "$NHEIR_APP" >/dev/null 2>&1; then
		ok "Accessibility granted to Nehir (user db)"
	elif sudo -n tccutil-rs grant Accessibility "$NHEIR_APP" >/dev/null 2>&1; then
		ok "Accessibility granted to Nehir (system db via sudo)"
	else
		fail "Could not grant Accessibility to Nehir automatically."
		echo "     Grant manually: System Settings → Privacy & Security →"
		echo "     Accessibility → '+' → add Nehir.app"
	fi
else
	fail "tccutil-rs not found — install it (brew install tccutil-rs) and re-run."
	echo "     Manual fallback: System Settings → Privacy & Security →"
	echo "     Accessibility → '+' → add Nehir.app"
fi

# ─────────────────────────────────────────────────────────────
# Post-grant verification (requires Full Disk Access on the
# terminal app for tccutil-rs to read TCC.db).
# ─────────────────────────────────────────────────────────────
note "Verifying grants (requires Full Disk Access on the host terminal)..."
if command -v tccutil-rs >/dev/null 2>&1; then
	if tccutil-rs list --user --service Accessibility 2>/dev/null | grep -qF "$NHEIR_APP"; then
		ok "Nehir found in Accessibility list (user db)"
	elif tccutil-rs list --service Accessibility 2>/dev/null | grep -qF "$NHEIR_APP"; then
		ok "Nehir found in Accessibility list (system db)"
	else
		warn "Nehir not visible in the Accessibility list"
		echo "     If the terminal app lacks Full Disk Access, verification is"
		echo "     unreliable — the grant may still have succeeded."
	fi
else
	warn "tccutil-rs not found — skipping verification"
fi

warn "If grants failed: the terminal app running this installer needs"
echo "     'Full Disk Access' (System Settings → Privacy & Security → Full Disk Access),"
echo "     then quit and reopen the terminal and re-run: bash scripts/grant-permissions"

echo ""
ok "Permission grants finished"