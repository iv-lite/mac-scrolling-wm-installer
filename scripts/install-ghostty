#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

CYAN=$'\033[0;36m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
RESET=$'\033[0m'

note() { echo "  ${CYAN}→ $*${RESET}"; }
ok()   { echo "  ${GREEN}✓ $*${RESET}"; }
warn() { echo "  ${YELLOW}⚠ $*${RESET}"; }

# ─────────────────────────────────────────────────────────────
# Install Ghostty (opened via Ctrl+Cmd+T)
# ─────────────────────────────────────────────────────────────
note "Installing/upgrading Ghostty terminal..."
if brew list --cask ghostty >/dev/null 2>&1; then
	note "Ghostty already installed — upgrading..."
	brew upgrade --cask ghostty 2>/dev/null || warn "Ghostty upgrade failed (network?) — keeping installed version"
	ok "Ghostty up to date"
else
	brew install --cask ghostty
	ok "Ghostty installed"
fi

# ─────────────────────────────────────────────────────────────
# Config (frameless, niri-style)
# ─────────────────────────────────────────────────────────────
mkdir -p ~/.config/ghostty

if [ -f ~/.config/ghostty/config ]; then
	note "Existing config found at ~/.config/ghostty/config — backing up"
	cp ~/.config/ghostty/config ~/.config/ghostty/config.bak
fi

cp "$REPO_ROOT/config/ghostty/config" ~/.config/ghostty/config
ok "Ghostty config installed to ~/.config/ghostty/config"