#!/usr/bin/env bash
set -euo pipefail

CYAN=$'\033[0;36m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
RED=$'\033[0;31m'
RESET=$'\033[0m'

note() { echo "  ${CYAN}→ $*${RESET}"; }
ok()   { echo "  ${GREEN}✓ $*${RESET}"; }
warn() { echo "  ${YELLOW}⚠ $*${RESET}"; }
fail() { echo "  ${RED}✗ $*${RESET}"; }

# ─────────────────────────────────────────────────────────────
# Read/set "Displays have separate Spaces" (Space Management Mode).
#
# Paneru requires this setting to be live-enabled: it queries the private
# SkyLight mode (SLSGetSpaceManagementMode == 1), NOT the legacy
# `defaults write com.apple.spaces spans-displays` knob, which macOS 26
# no longer applies to the live windowserver state.
#
# Usage:
#   ensure-separate-spaces check   → exit 0 if separate spaces ON, else 1
#   ensure-separate-spaces set     → enable via the private API + plist,
#                                    verify, exit 0/1
# ─────────────────────────────────────────────────────────────

PY="$(cat <<'PY'
import ctypes, sys

f = ctypes.CDLL("/System/Library/PrivateFrameworks/SkyLight.framework/SkyLight")
f.SLSMainConnectionID.restype = ctypes.c_uint
conn = f.SLSMainConnectionID()
f.SLSGetSpaceManagementMode.argtypes = [ctypes.c_uint]
f.SLSGetSpaceManagementMode.restype = ctypes.c_int

mode = f.SLSGetSpaceManagementMode(conn)

if len(sys.argv) > 1 and sys.argv[1] == "set" and mode != 1:
    f.SLSSetSpaceManagementMode.argtypes = [ctypes.c_uint, ctypes.c_int]
    f.SLSSetSpaceManagementMode.restype = ctypes.c_int
    f.SLSSetSpaceManagementMode(conn, 1)
    mode = f.SLSGetSpaceManagementMode(conn)

print(mode)
PY
)"

current_mode() { python3 - "$@" <<Y
$PY
Y
}

ACTION="${1:-check}"

if ! command -v python3 >/dev/null 2>&1; then
	fail "python3 not found — cannot probe the Spaces setting."
	exit 1
fi

MODE="$(current_mode "$ACTION" 2>/dev/null || true)"

if [ "$MODE" = "1" ]; then
	ok "'Displays have separate Spaces' is enabled (mode $MODE)"
	exit 0
fi

if [ "$ACTION" = "set" ]; then
	note "Enabling 'Displays have separate Spaces' via the private SkyLight API..."
	MODE="$(current_mode set 2>/dev/null || true)"
	if [ "$MODE" = "1" ]; then
		# Persist so the live state survives a reboot/login.
		PLIST="$HOME/Library/Preferences/com.apple.spaces.plist"
		if [ -f "$PLIST" ]; then
			/usr/libexec/PlistBuddy \
				-c 'Set :SpacesDisplayConfiguration:Management\ Data:Management\ Mode 1' \
				"$PLIST" 2>/dev/null || true
		fi
		killall cfprefsd Dock 2>/dev/null || true
		ok "'Displays have separate Spaces' enabled + persisted"
		exit 0
	fi
fi

fail "'Displays have separate Spaces' is disabled (mode $MODE)."
echo "     Paneru requires this setting ON and it cannot be applied while the"
echo "     current GUI session is live (macOS 26 reads the private windowserver"
echo "     state, not \`defaults write\`). Enable it, then re-run the installer:"
echo "       System Settings → Desktop & Dock → 'Displays have separate Spaces' → ON"
echo "     (on macOS 26, leaving it OFF risks a WindowServer crash at next login;"
echo "      Apple bug 153570422.)"
exit 1