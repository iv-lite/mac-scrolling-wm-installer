#!/usr/bin/env bash
set -euo pipefail

# Cycle the focused column's width through the config's min / mid / max
# scroll ratios. Reads the live ratio from `query layout`, picks the next
# preset (wrapping around), and resizes by the exact delta.

rift="$(command -v rift-cli || true)"
[ -n "$rift" ] && [ -x "$rift" ] || exit 0

# Focused column's current width ratio (engine-exact).
ratio="$(command "$rift" query layout 2>/dev/null | jq -r '.. | objects |
	select(.role == "column" and ([.children[]?.is_selected] | any)) | .weight' 2>/dev/null || true)"
[ -n "$ratio" ] || exit 0

# Live min/max scroll ratios from config (defaults 0.3 / 1.0).
minmax="$(command "$rift" execute config get 2>/dev/null | jq -r \
	'[.settings.layout.scrolling.min_column_width_ratio // 0.3,
	  .settings.layout.scrolling.max_column_width_ratio // 1.0] | @tsv' 2>/dev/null || true)"
[[ "$minmax" == *$'\t'* ]] || exit 0
min="${minmax%%$'\t'*}"; max="${minmax##*$'\t'}"

delta="$(awk -v min="$min" -v max="$max" -v ratio="$ratio" 'BEGIN {
	snap = 0.02; eps = 1e-6
	mid = int(100 * (min + max) / 2 + 0.5) / 100
	if      (ratio - min < snap && min - ratio < snap) r = min
	else if (ratio - mid < snap && mid - ratio < snap) r = mid
	else if (ratio - max < snap && max - ratio < snap) r = max
	else r = ratio
	if (r >= max - eps)      t = min
	else if (r >= mid - eps) t = max
	else                     t = mid
	printf "%.4f", t - r
	exit
}')"

case "$delta" in ''|*[!0-9.+-]*|*nan*|*inf*) exit 0 ;; esac
command "$rift" execute window resize-by -- "$delta"