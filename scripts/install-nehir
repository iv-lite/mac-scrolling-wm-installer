#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

CYAN=$'\033[0;36m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
RED=$'\033[0;31m'
RESET=$'\033[0m'

note() { echo "  ${CYAN}→ $*${RESET}"; }
ok()   { echo "  ${GREEN}✓ $*${RESET}"; }
warn() { echo "  ${YELLOW}⚠ $*${RESET}"; }
fail() { echo "  ${RED}✗ $*${RESET}"; exit 1; }

LAUNCH_AGENT="$HOME/Library/LaunchAgents/dev.guria.nehir.plist"

# Resolve the app path — the cask installs to /Applications, the source
# build to ~/Applications.
app_path() {
	if [ -d /Applications/Nehir.app ]; then
		echo "/Applications/Nehir.app"
	elif [ -d "$HOME/Applications/Nehir.app" ]; then
		echo "$HOME/Applications/Nehir.app"
	else
		echo ""
	fi
}

# ─────────────────────────────────────────────────────────────
# Install Nehir: Homebrew cask first (guria/tap — the RC cask
# tracks the latest preview, the plain cask the stable release),
# falling back to a from-source build via mise when no cask is
# available yet. Requires full Xcode (Command Line Tools alone
# cannot build the app).
# ─────────────────────────────────────────────────────────────
installed_cask() {
	if brew list --cask nehir@rc >/dev/null 2>&1; then
		echo "nehir@rc"
	elif brew list --cask nehir >/dev/null 2>&1; then
		echo "nehir"
	else
		echo ""
	fi
}

require_full_xcode() {
	command -v xcodebuild >/dev/null 2>&1 || return 1
	[ "$(xcode-select -p 2>/dev/null)" != "/Library/Developer/CommandLineTools" ] || return 1
	xcodebuild -version >/dev/null 2>&1 || return 1
}

install_nehir() {
	local app; app="$(app_path)"
	if [ -n "$app" ]; then
		note "Nehir found at $app — upgrading..."
		local cask_short cask
		cask_short="$(installed_cask)"
		if [ -n "$cask_short" ]; then
			cask="guria/tap/$cask_short"
			brew upgrade --cask "$cask" >/dev/null 2>&1 && ok "Nehir upgraded via Homebrew ($cask_short)" \
				|| warn "Nehir upgrade failed (network?) — keeping installed version"
		elif command -v brew >/dev/null 2>&1 && brew trust guria/tap 2>/dev/null && brew tap guria/tap 2>/dev/null && [ -n "$(installed_cask)" ]; then
			cask_short="$(installed_cask)"
			brew upgrade --cask "guria/tap/$cask_short" >/dev/null 2>&1 && ok "Nehir upgraded via Homebrew ($cask_short)" \
				|| warn "Nehir upgrade failed (network?) — keeping installed version"
		else
			warn "Nehir.app exists but is not tracked by a brew cask — keeping installed version"
		fi
		return 0
	fi

	if command -v brew >/dev/null 2>&1; then
		note "Trusting and tapping guria/tap (Nehir cask repository)..."
		brew trust guria/tap
		brew tap guria/tap
		ok "guria/tap tapped"

		if brew info --cask guria/tap/nehir@rc >/dev/null 2>&1; then
			note "Installing Nehir via the RC cask (guria/tap/nehir@rc — latest preview)..."
			brew install --cask guria/tap/nehir@rc
			ok "Nehir installed via Homebrew (RC cask)"
			return 0
		fi
		if brew info --cask guria/tap/nehir >/dev/null 2>&1; then
			note "RC cask unavailable — installing stable Nehir (guria/tap/nehir)..."
			brew install --cask guria/tap/nehir
			ok "Nehir installed via Homebrew (stable cask)"
			return 0
		fi
		warn "No nehir cask found in guria/tap — falling back to a source build."
	else
		warn "Homebrew not available — installing Nehir from source."
	fi
	install_nehir_source
}

install_nehir_source() {
	note "Building Nehir from source (requires full Xcode + ~5-10 minutes)..."
	if ! command -v mise >/dev/null 2>&1; then
		note "Installing mise (dev tool manager)..."
		if ! command -v brew >/dev/null 2>&1; then
			fail "mise not installed and Homebrew is unavailable — install mise first"
		fi
		brew install mise
	fi
	if ! require_full_xcode; then
		if command -v xcodebuild >/dev/null 2>&1 && [ "$(xcode-select -p 2>/dev/null)" = "/Library/Developer/CommandLineTools" ]; then
			fail "Only Command Line Tools are installed — the Nehir source build needs full Xcode."
			echo "     Install Xcode from the App Store, then: sudo xcode-select -s /Applications/Xcode.app"
			echo "     (or re-run the installer so it picks up the Homebrew cask again)"
			exit 1
		fi
		fail "Xcode not found — the Nehir source build needs full Xcode (not just Command Line Tools)."
	fi

	local build_dir="$HOME/.cache/nehir-src"
	mkdir -p "$build_dir"
	if [ -d "$build_dir/.git" ]; then
		note "Updating Nehir checkout in $build_dir..."
		git -C "$build_dir" fetch --depth 1 origin main >/dev/null 2>&1 || true
		git -C "$build_dir" reset --hard origin/main >/dev/null 2>&1 || true
	else
		note "Cloning apphane-dev/nehir into $build_dir..."
		git clone --depth 1 https://github.com/apphane-dev/nehir.git "$build_dir" >/dev/null 2>&1
	fi

	(
		cd "$build_dir"
		note "Running 'mise run package:release' (ad-hoc signed, not notarized)..."
		mise run package:release
	)
	ok "Nehir built — dist/Nehir.app + nehirctl produced"

	note "Installing Nehir.app to ~/Applications and nehirctl to ~/.local/bin..."
	mkdir -p "$HOME/Applications" "$HOME/.local/bin"
	rm -rf "$HOME/Applications/Nehir.app"
	cp -R "$build_dir/dist/Nehir.app" "$HOME/Applications/Nehir.app"
	install -m 755 "$build_dir/.build/apple/Products/Release/nehirctl" "$HOME/.local/bin/nehirctl"
	ok "Nehir installed (config synced below; chmod +x ~/.local/bin/nehirctl if PATH needs it)"
}

install_nehir

# ─────────────────────────────────────────────────────────────
# Migrate from a previous OmniWM install (the stack this repo
# replaced) — mirror the Paneru cleanup block from install-omniwm.
# ─────────────────────────────────────────────────────────────
if [ -d /Applications/OmniWM.app ] || [ -f "$HOME/Library/LaunchAgents/com.barut.OmniWM.plist" ] || [ -d "$HOME/.config/omniwm" ]; then
	note "A previous OmniWM install was found — removing it..."
	if pgrep -x OmniWM >/dev/null 2>&1; then
		pkill -x OmniWM 2>/dev/null || true
	fi
	if [ -f "$HOME/Library/LaunchAgents/com.barut.OmniWM.plist" ]; then
		launchctl bootout "gui/$(id -u)/com.barut.OmniWM" >/dev/null 2>&1 || true
		rm -f "$HOME/Library/LaunchAgents/com.barut.OmniWM.plist"
	fi
	if [ -d /Applications/OmniWM.app ]; then
		rm -rf /Applications/OmniWM.app
	fi
	if command -v brew >/dev/null 2>&1; then
		brew uninstall --cask omniwm >/dev/null 2>&1 || true
	fi

	BACKUP_DIR="$HOME/.config/backups/migrate-nehir-$(date +%Y%m%d-%H%M%S)"
	mkdir -p "$BACKUP_DIR"
	if [ -d "$HOME/.config/omniwm" ]; then
		mv "$HOME/.config/omniwm" "$BACKUP_DIR/"
	fi

	if command -v tccutil-rs >/dev/null 2>&1; then
		tccutil-rs revoke --user Accessibility "/Applications/OmniWM.app" >/dev/null 2>&1 || true
	fi

	ok "OmniWM removed (config kept in $BACKUP_DIR)"
fi

# ─────────────────────────────────────────────────────────────
# Config (split Nehir layout: settings.toml + hotkeys.toml +
# workspaces.toml + apprules.d/)
# ─────────────────────────────────────────────────────────────
NEHIR_DIR="$HOME/.config/nehir"
APP_RULES_DIR="$NEHIR_DIR/apprules.d"
mkdir -p "$NEHIR_DIR" "$APP_RULES_DIR"

backup_if_present() {
	local f="$1"
	if [ -e "$f" ]; then
		cp "$f" "$f.bak"
	fi
}

backup_if_present "$NEHIR_DIR/settings.toml"
backup_if_present "$NEHIR_DIR/hotkeys.toml"
backup_if_present "$NEHIR_DIR/workspaces.toml"

cp "$REPO_ROOT/config/nehir/settings.toml" "$NEHIR_DIR/settings.toml"
cp "$REPO_ROOT/config/nehir/hotkeys.toml" "$NEHIR_DIR/hotkeys.toml"
cp "$REPO_ROOT/config/nehir/workspaces.toml" "$NEHIR_DIR/workspaces.toml"
cp "$REPO_ROOT/config/nehir/apprules.d/"*.toml "$APP_RULES_DIR/"
ok "Nehir config installed to ~/.config/nehir/ (settings.toml, hotkeys.toml, workspaces.toml, apprules.d/)"
note "Missing keys fall back to built-in defaults; unknown keys are preserved."

# ─────────────────────────────────────────────────────────────
# launchd agent (autostart at login, keep alive; Nehir does not
# self-manage launching — this agent is what keeps it running)
# ─────────────────────────────────────────────────────────────
APP_PATH="$(app_path)"
if [ -z "$APP_PATH" ]; then
	fail "Nehir.app not found after install (looked in /Applications and ~/Applications)"
fi

note "Installing Nehir launchd agent ($LAUNCH_AGENT)..."
cat > "$LAUNCH_AGENT" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.guria.nehir</string>
	<key>Program</key>
	<string>$APP_PATH/Contents/MacOS/Nehir</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
EOF
ok "LaunchAgent written (started by enable-services)"

warn "Nehir will be launched by enable-services after permissions are granted."
echo "     (grant Accessibility to Nehir; see grant-permissions)"