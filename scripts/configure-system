#!/usr/bin/env bash
set -euo pipefail

CYAN=$'\033[0;36m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
RESET=$'\033[0m'

note() { echo "  ${CYAN}→ $*${RESET}"; }
ok()   { echo "  ${GREEN}✓ $*${RESET}"; }
warn() { echo "  ${YELLOW}⚠ $*${RESET}"; }

# Unlike Rift, Nehir does not require "Displays have separate Spaces" to be
# enabled — it simulates virtual workspaces itself (by parking windows
# off-screen within one macOS Space) rather than depending on that private
# SkyLight mode, so there's nothing to enforce here anymore.

# Show the native macOS menu bar again (Nehir's [workspaceBar] draws
# workspace indicators there). Un-hides the bar even when upgrading from an
# Aegis-era install.
if [ "$(defaults read NSGlobalDomain _HIHideMenuBar 2>/dev/null)" = "1" ]; then
	note "Showing the native menu bar again (Nehir draws its indicators there)..."
	defaults write NSGlobalDomain _HIHideMenuBar -bool false
	ok "_HIHideMenuBar set to off"
else
	ok "'Hide menu bar' already off"
fi

killall SystemUIServer 2>/dev/null || true
killall Finder 2>/dev/null || true
