#!/usr/bin/env bash
set -euo pipefail

CYAN=$'\033[0;36m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
RESET=$'\033[0m'

note() { echo "  ${CYAN}→ $*${RESET}"; }
ok()   { echo "  ${GREEN}✓ $*${RESET}"; }
warn() { echo "  ${YELLOW}⚠ $*${RESET}"; }

# Disable "Displays have separate Spaces" — AeroSpace's recommended setting.
# Counterintuitive: spans-displays = true ⇔ separate Spaces OFF.
# AeroSpace manages its own virtual workspaces; having fewer macOS Spaces makes
# the public APIs it relies on more stable (focus, cross-monitor moves).
if [ "$(defaults read com.apple.spaces spans-displays 2>/dev/null)" != "1" ]; then
	note "Disabling 'Displays have separate Spaces' (AeroSpace-recommended)..."
	defaults write com.apple.spaces "spans-displays" -bool true
	ok "spans-displays set to true (spaces span all displays)"
else
	ok "'Displays have separate Spaces' already disabled"
fi

# The native menu bar stays visible — AeroSpaceBar lives inside it.
# (No need to touch the menu bar visibility settings at all.)

# Attempt to apply immediately (logout/login still recommended for the Spaces setting).
killall SystemUIServer 2>/dev/null || true
killall Finder 2>/dev/null || true

warn "A logout/login is still required for the Spaces setting to fully take effect."