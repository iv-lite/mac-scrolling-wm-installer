#!/usr/bin/env bash
set -euo pipefail

CYAN=$'\033[0;36m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
RESET=$'\033[0m'

note() { echo "  ${CYAN}→ $*${RESET}"; }
ok()   { echo "  ${GREEN}✓ $*${RESET}"; }
warn() { echo "  ${YELLOW}⚠ $*${RESET}"; }

# Enable "Displays have separate Spaces" — Rift's recommended setting.
# Counterintuitive: spans-displays = false ⇔ separate Spaces ON.
# Unlike AeroSpace, Rift works with separate Spaces enabled (and recommends it);
# each display/space gets its own independent tiling layout.
if [ "$(defaults read com.apple.spaces spans-displays 2>/dev/null)" != "0" ]; then
	note "Enabling 'Displays have separate Spaces' (Rift-recommended)..."
	defaults write com.apple.spaces "spans-displays" -bool false
	ok "spans-displays set to false (separate Spaces)"
else
	ok "'Displays have separate Spaces' already enabled"
fi

# The native menu bar stays visible — Rift draws its workspace indicators there.
# (No need to touch the menu bar visibility settings at all.)

# Attempt to apply immediately (logout/login still recommended for the Spaces setting).
killall SystemUIServer 2>/dev/null || true
killall Finder 2>/dev/null || true

warn "A logout/login is still required for the Spaces setting to fully take effect."