#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

CYAN=$'\033[0;36m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
RESET=$'\033[0m'

note() { echo "  ${CYAN}→ $*${RESET}"; }
ok()   { echo "  ${GREEN}✓ $*${RESET}"; }
warn() { echo "  ${YELLOW}⚠ $*${RESET}"; }

# ─────────────────────────────────────────────────────────────
# Install Rift
# ─────────────────────────────────────────────────────────────
if command -v rift >/dev/null 2>&1; then
	before="$(rift --version 2>/dev/null || echo 'unknown')"
	note "Rift already installed ($before) — upgrading..."
	brew trust acsandmann/tap 2>/dev/null || true
	brew tap acsandmann/tap
	brew upgrade acsandmann/tap/rift 2>/dev/null || warn "Rift upgrade failed (network?) — keeping $before"
	after="$(rift --version 2>/dev/null || echo 'unknown')"
	if [ "$before" = "$after" ]; then
		ok "Rift is up to date ($after)"
	else
		ok "Rift upgraded: $before → $after"
	fi
else
	note "Installing Rift via Homebrew..."
	brew trust acsandmann/tap 2>/dev/null || true
	brew tap acsandmann/tap
	brew install acsandmann/tap/rift
	ok "Rift installed"
fi

# ─────────────────────────────────────────────────────────────
# Config
# ─────────────────────────────────────────────────────────────
mkdir -p ~/.config/rift

if [ -f ~/.config/rift/config.toml ]; then
	note "Existing config found at ~/.config/rift/config.toml — backing up"
	cp ~/.config/rift/config.toml ~/.config/rift/config.toml.bak
fi

cp "$REPO_ROOT/config/rift/config.toml" ~/.config/rift/config.toml

ok "Rift config installed to ~/.config/rift/config.toml"

# ─────────────────────────────────────────────────────────────
# launchd service (applies Accessibility before start)
# ─────────────────────────────────────────────────────────────
note "Installing Rift launchd service..."
if [ -f "$HOME/Library/LaunchAgents/git.acsandmann.rift.plist" ]; then
	ok "Rift launchd service already installed (plist refreshed on 'rift service start')"
else
	rift service install
	ok "Rift service installed"
fi

warn "Rift will be started by enable-services after permissions are granted."