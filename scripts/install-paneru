#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
# shellcheck source=lib/swift-common.sh
source "$SCRIPT_DIR/lib/swift-common.sh"

CYAN=$'\033[0;36m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
RESET=$'\033[0m'

note() { echo "  ${CYAN}→ $*${RESET}"; }
ok()   { echo "  ${GREEN}✓ $*${RESET}"; }
warn() { echo "  ${YELLOW}⚠ $*${RESET}"; }

# ─────────────────────────────────────────────────────────────
# Install paneru-swift (the only daemon; the Rust daemon is gone).
# ─────────────────────────────────────────────────────────────
# Default: download the paneru-swift release tarball from GitHub.
# With --prefer-local-builds (PREFER_LOCAL_BUILDS=1): build from
# the sibling ../paneru-swift/swift-daemon checkout instead (paneru-swift,
# RenderPlist, pq) — no release fallback on build failure.
# PANERU_TAG pins an exact release tag (PANERU_REPO changes the repo).
PANERU_REPO="${PANERU_REPO:-iv-lite/paneru}"
if [ -n "${PANERU_TAG:-}" ]; then
	PANERU_SOURCE="https://api.github.com/repos/$PANERU_REPO/releases/tags/$PANERU_TAG"
	PANERU_LABEL="$PANERU_REPO@$PANERU_TAG"
else
	PANERU_SOURCE="https://api.github.com/repos/$PANERU_REPO/releases?per_page=100"
	PANERU_LABEL="$PANERU_REPO (newest release in list)"
fi

# The installed Swift daemon's signing identity (upstream Swift label).
PANERU_SWIFT_ID="$PANERU_SWIFT_LABEL"

pick_bindir() {
	if [ -n "${PANERU_BINDIR:-}" ]; then
		mkdir -p "$PANERU_BINDIR" 2>/dev/null || return 1
		[ -w "$PANERU_BINDIR" ] || return 1
		echo "$PANERU_BINDIR"
		return 0
	fi
	for d in /opt/homebrew/bin /usr/local/bin; do
		if [ -d "$d" ] && [ -w "$d" ]; then
			echo "$d"
			return 0
		fi
	done
	mkdir -p "$HOME/.local/bin" 2>/dev/null || true
	echo "$HOME/.local/bin"
	return 0
}

# Persistent signing identity for sticky Accessibility grants. Resolved once
# per run via the canonical daemon copy (../paneru-swift/swift-daemon) when a
# sibling checkout exists, else this repo's byte-identical fallback, else
# $PANERU_SIGN_IDENTITY override for a paid Developer ID. "-" means ad-hoc
# fallback: installs work, but each byte change needs a fresh grant.
resolve_sign_identity() {
	if [ -n "${PANERU_SIGN_IDENTITY_RESOLVED:-}" ]; then
		echo "$PANERU_SIGN_IDENTITY_RESOLVED"
		return 0
	fi
	local helper="" id
	if [ -f "$REPO_ROOT/../paneru-swift/swift-daemon/ensure-signing-identity" ]; then
		helper="$REPO_ROOT/../paneru-swift/swift-daemon/ensure-signing-identity"
	else
		helper="$SCRIPT_DIR/ensure-signing-identity"
	fi
	id="$(bash "$helper" 2>/dev/null || echo "-")"
	[ -n "$id" ] || id="-"
	PANERU_SIGN_IDENTITY_RESOLVED="$id"
	export PANERU_SIGN_IDENTITY_RESOLVED
	echo "$id"
}

# True when $1 is signed with a stable designated requirement (identifier
# + certificate), not an ad-hoc cdhash-only one. Used to decide whether a
# byte-identical binary still needs re-signing.
swift_dr_is_stable() {
	local bin="$1"
	command -v codesign >/dev/null 2>&1 || return 1
	local dr
	dr="$(codesign -d -r- "$bin" 2>/dev/null | grep -E 'designated =>' || true)"
	[ -n "$dr" ] || return 1
	case "$dr" in
		*cdhash*) return 1 ;;
	esac
	case "$dr" in
		*identifier*|*certificate*|*anchor*) return 0 ;;
	esac
	return 1
}

# Sign $2 with identifier $1 using the persistent identity. Verifies the
# designated requirement carries identifier+certificate (not cdhash-only)
# and that `codesign --verify --strict` passes. Returns 0 on success.
sign_bin() {
	local identifier="$1" bin="$2" identity sign_err=""
	identity="$(resolve_sign_identity)"
	if ! command -v codesign >/dev/null 2>&1; then
		note "codesign not found (not macOS?) — skipping identifier pinning"
		return 1
	fi
	if ! sign_err="$(codesign --force --sign "$identity" --identifier "$identifier" "$bin" 2>&1)"; then
		warn "codesign failed — the Accessibility grant may not apply to this build"
		[ -n "$sign_err" ] && warn "  codesign: $sign_err"
		return 1
	fi
	if [ "$identity" = "-" ]; then
		warn "Ad-hoc signed ($identifier) — grants will NOT survive the next rebuild; run scripts/ensure-signing-identity to fix"
	else
		ok "Code-signed with stable identity '$identity' ($identifier)"
	fi
	if codesign -d -r- "$bin" 2>/dev/null | grep -q "identifier \"$identifier\""; then
		ok "Designated requirement carries identifier ($identifier)"
	else
		warn "Designated requirement check failed — grant may not stick"
	fi
	if ! swift_signature_trusted "$bin"; then
		warn "Code signature does not verify (missing/untrusted signing cert) — TCC will deny this binary"
		warn "  Recreate the identity: bash scripts/ensure-signing-identity, then re-run"
		return 1
	fi
	if codesign --verify --strict "$bin" >/dev/null 2>&1; then
		ok "Code signature verifies (strict)"
	else
		warn "codesign --verify --strict failed — the binary may not launch cleanly"
		return 1
	fi
	return 0
}

# swift-daemon is Swift 6 language mode (swift-tools-version 6.0): older
# toolchains fail deep in the build, so gate source builds here with a
# clear message. Unparseable output only warns — future toolchains must
# never hard-block on this check.
swift_toolchain_six() {
	local swift_major
	swift_major="$(swift --version 2>&1 | grep -oE 'Swift version [0-9]+' | grep -oE '[0-9]+' | head -1 || true)"
	if [ -n "$swift_major" ] && [ "$swift_major" -lt 6 ]; then
		echo "Swift $swift_major detected — paneru-swift needs the Swift 6 toolchain (Xcode 16+)." >&2
		echo "Update Xcode (App Store) or the command-line tools ('xcode-select --install'), then re-run." >&2
		return 1
	fi
	return 0
}

# Render the launchd agent plist for the installed binary and pin the
# PANERU_MACH_SERVICE env var to the Swift label (swift-common.sh's pq
# wrapper relies on it). `render` is an optional RenderPlist binary from a
# source build; when absent (release tarballs do not ship it) the plist is
# emitted here, byte-faithful in keys to the daemon's `launchAgentPlist`
# (`swift-daemon/Sources/Service/Service.swift`): KeepAlive
# {Crashed, !SuccessfulExit}, Label, MachServices, Nice -20, ProcessType
# Interactive, Program, EnvironmentVariables {NO_COLOR, RUST_LOG,
# XDG_CONFIG_HOME}, RunAtLoad, ThrottleInterval 30, StandardOut/ErrorPath.
render_agent_plist_bash() {
	local bin="$1" plist="$2" out_log="$3" err_log="$4" xdg_home="$5" rust_log
	rust_log="${RUST_LOG:-info}"
	cat > "$plist" <<-EOF
		<?xml version="1.0" encoding="UTF-8"?>
		<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
		<plist version="1.0">
		  <dict>
		    <key>KeepAlive</key>
		    <dict>
		      <key>Crashed</key>
		      <true />
		      <key>SuccessfulExit</key>
		      <false />
		    </dict>
		    <key>Label</key>
		    <string>$PANERU_SWIFT_LABEL</string>
		    <key>MachServices</key>
		    <dict>
		      <key>$PANERU_SWIFT_LABEL</key>
		      <true />
		    </dict>
		    <key>Nice</key>
		    <integer>-20</integer>
		    <key>ProcessType</key>
		    <string>Interactive</string>
		    <key>Program</key>
		    <string>$bin</string>
		    <key>EnvironmentVariables</key>
		    <dict>
		      <key>NO_COLOR</key>
		      <string>1</string>
		      <key>RUST_LOG</key>
		      <string>$rust_log</string>
		      <key>XDG_CONFIG_HOME</key>
		      <string>$xdg_home</string>
		    </dict>
		    <key>RunAtLoad</key>
		    <true />
		    <key>ThrottleInterval</key>
		    <integer>30</integer>
		    <key>StandardErrorPath</key>
		    <string>$err_log</string>
		    <key>StandardOutPath</key>
		    <string>$out_log</string>
		  </dict>
		</plist>
		EOF
}

# Render the launchd agent plist for the installed binary and pin the
# PANERU_MACH_SERVICE env var to the Swift label (swift-common.sh's pq
# wrapper relies on it). Shared by release and source installs.
render_agent_plist() {
	local bin="$1" render="$2" plist out_log err_log xdg_home
	plist="$HOME/Library/LaunchAgents/$PANERU_SWIFT_LABEL.plist"
	out_log="/tmp/${PANERU_SWIFT_LABEL}_$(id -u).out.log"
	err_log="/tmp/${PANERU_SWIFT_LABEL}_$(id -u).err.log"
	xdg_home="${XDG_CONFIG_HOME:-$HOME/.config}"
	mkdir -p "$(dirname "$plist")"
	if [ -n "$render" ] && [ -x "$render" ]; then
		if ! "$render" "$PANERU_SWIFT_LABEL" "$bin" "$out_log" "$err_log" "$xdg_home" > "$plist"; then
			note "RenderPlist failed — skipping agent plist"
			return 1
		fi
	else
		render_agent_plist_bash "$bin" "$plist" "$out_log" "$err_log" "$xdg_home"
	fi
	if command -v /usr/libexec/PlistBuddy >/dev/null 2>&1; then
		/usr/libexec/PlistBuddy -c "Add :EnvironmentVariables:PANERU_MACH_SERVICE string $PANERU_SWIFT_LABEL" "$plist" >/dev/null 2>&1 \
			|| /usr/libexec/PlistBuddy -c "Set :EnvironmentVariables:PANERU_MACH_SERVICE $PANERU_SWIFT_LABEL" "$plist" >/dev/null 2>&1 \
			|| warn "Could not pin PANERU_MACH_SERVICE in $plist — pq may not reach a bootstrapped agent"
	else
		warn "PlistBuddy not found — skipping PANERU_MACH_SERVICE pin (pq may not reach a bootstrapped agent)"
	fi
	touch "$out_log" "$err_log" 2>/dev/null || true
	ok "Swift agent plist rendered ($plist)"
}

# Install the two staged binaries (paneru-swift + pq) into the bindir:
# stop a running agent, byte-identical fast path, sign with the persistent
# identity, stamp, and render the agent plist. `staged` and `pg_staged` are
# absolute paths to freshly built or downloaded binaries.
install_staged_swift() {
	local staged="$1" render="$2" pq_staged="$3" bindir bin pq_bin
	bindir="$(pick_bindir)" || return 1
	bin="$bindir/paneru-swift"
	pq_bin="$bindir/pq"
	# Migrate the previous Swift label once (upstream d04db61 renamed the
	# Swift identity): stop the old agent and drop its plist/logs so two
	# Swift agents never overlap.
	swift_migrate_old_agent
	# Boot out a running Swift agent before overwriting its binary.
	if swift_bootstrapped; then
		launchctl bootout "gui/$(id -u)/$PANERU_SWIFT_LABEL" >/dev/null 2>&1 || true
		sleep 1
	fi
	mkdir -p "$(dirname "$bin")"
	# No stable signing identity, no install: ad-hoc signatures embed a
	# cdhash-only designated requirement, so every rebuild looks like a
	# new app to TCC and voids the Accessibility grant — the next boot
	# then tiles nothing, silently. Byte-identical reinstalls are exempt
	# (same bytes ⇒ same cdhash ⇒ the live grant still applies).
	if [ ! -e "$bin" ] || ! cmp -s "$staged" "$bin"; then
		if [ "$(resolve_sign_identity)" = "-" ] && [ -z "${PANERU_ALLOW_ADHOC:-}" ]; then
			echo "  Refusing install: no stable signing identity (ad-hoc fallback)." >&2
			echo "  An ad-hoc paneru-swift loses its Accessibility grant on the next rebuild." >&2
			echo "  Run 'bash scripts/ensure-signing-identity', then re-run — or override once with PANERU_ALLOW_ADHOC=1." >&2
			return 1
		fi
	fi
	# Byte-identical: skip copy + re-sign ONLY when the on-disk binary is
	# already signed with the stable identity. A byte-identical ad-hoc
	# binary (e.g. installed by an older tool) must be re-signed here, or
	# it keeps its cdhash-only DR and voids the grant on the next rebuild.
	if [ -e "$bin" ] && cmp -s "$staged" "$bin" && swift_dr_is_stable "$bin"; then
		ok "Swift daemon binary unchanged ($bin)"
	else
		cp "$staged" "$bin"
		chmod +x "$bin"
		hash -r 2>/dev/null || true
		ok "Swift daemon installed to $bin"
		sign_bin "$PANERU_SWIFT_ID" "$bin" || true
	fi
	# Identity stamp: identifier + cdhash + path. grant-permissions
	# compares it on the next run — any drift (rebuild, rename, move)
	# forces the grant flow instead of trusting stale TCC rows.
	swift_write_stamp "$bin"
	# pq rides along unsigned: it needs no Accessibility grant (it only
	# talks to the daemon over XPC), so no identifier pinning here.
	if [ -e "$pq_bin" ] && cmp -s "$pq_staged" "$pq_bin"; then
		ok "pq unchanged ($pq_bin)"
	else
		cp "$pq_staged" "$pq_bin"
		chmod +x "$pq_bin"
		hash -r 2>/dev/null || true
		ok "pq installed to $pq_bin (state queries + script-state CLI)"
	fi
	render_agent_plist "$bin" "$render" || return 1
	note "Swift daemon (re)installed with a stable signing identity — the"
	note "renamed identifier (upstream renamed to com.github.iv-lite.paneru-swift)"
	note "re-prompts once: remove the stale old Swift Accessibility row, toggle"
	note "the new paneru-swift row on; later rebuilds keep the grant."
	note "grant-permissions (next) grants only when missing; enable-services"
	note "bootstraps the agent."
	return 0
}

# ─────────────────────────────────────────────────────────────
# Default path: download the paneru-swift release tarball.
# ─────────────────────────────────────────────────────────────
fetch_swift_release() {
	local tmp tar_url staged render pq_staged
	note "Fetching paneru-swift release ($PANERU_LABEL)..."
	tar_url="$(curl -fsSL "$PANERU_SOURCE" \
		| grep -o '"browser_download_url": *"[^"]*paneru-swift-[^"]*\.tar\.gz"' | head -1 | cut -d'"' -f4 || true)"
	if [ -z "$tar_url" ]; then
		note "No paneru-swift-*.tar.gz asset on release ($PANERU_LABEL)"
		return 1
	fi
	tmp="$(mktemp -d)"
	trap 'rm -rf "$tmp"' EXIT
	note "Downloading $(basename "$tar_url")..."
	if ! curl -fsSL "$tar_url" -o "$tmp/paneru-swift.tgz"; then
		note "Download failed"
		return 1
	fi
	if ! tar -xzf "$tmp/paneru-swift.tgz" -C "$tmp"; then
		note "Extraction failed"
		return 1
	fi
	staged="$(find "$tmp" -maxdepth 3 -name paneru-swift -type f | head -1 || true)"
	pq_staged="$(find "$tmp" -maxdepth 3 -name pq -type f | head -1 || true)"
	if [ -z "$staged" ] || [ ! -x "$staged" ] || [ -z "$pq_staged" ] || [ ! -x "$pq_staged" ]; then
		note "Release tarball is missing the paneru-swift and/or pq binary"
		return 1
	fi
	# Release tarballs do not ship RenderPlist (daemon-build-only): the
	# plist falls back to the bash template inside install_staged_swift.
	render="$(find "$tmp" -maxdepth 3 -name RenderPlist -type f | head -1 || true)"
	[ -n "$render" ] && [ -x "$render" ] || render=""
	ok "paneru-swift release downloaded ($(basename "$tar_url"))"
	install_staged_swift "$staged" "$render" "$pq_staged"
	local status=$?
	rm -rf "$tmp"
	trap - EXIT
	return "$status"
}

# ─────────────────────────────────────────────────────────────
# --prefer-local-builds path: build from the sibling ../paneru-swift checkout.
# ─────────────────────────────────────────────────────────────
fetch_swift_local() {
	local pkg staged render pq_staged bindir
	pkg="$REPO_ROOT/../paneru-swift/swift-daemon"
	if [ ! -f "$pkg/Package.swift" ]; then
		note "No sibling checkout with swift-daemon ($pkg/Package.swift missing) — falling back to release download"
		return 2
	fi
	if ! command -v swift >/dev/null 2>&1; then
		echo "  'swift' not found — install the Xcode command-line tools ('xcode-select --install'), then re-run." >&2
		return 1
	fi
	if ! swift_toolchain_six; then
		return 1
	fi
	note "Building Swift daemon from sibling checkout ($pkg)..."
	if [ -n "${PANERU_VERIFY:-}" ]; then
		bash "$SCRIPT_DIR/verify-swift" "$pkg" || return 1
	fi
	# In-place build (keeps .build/ cache, fully offline: local targets +
	# vendored C). One product per invocation; bindir via --show-bin-path.
	for product in paneru-swift RenderPlist pq; do
		if ! (cd "$pkg" && swift build -c release --product "$product"); then
			echo "  Swift $product build failed — aborting." >&2
			return 1
		fi
	done
	bindir="$(cd "$pkg" && swift build -c release --show-bin-path)" || return 1
	staged="$bindir/paneru-swift"
	render="$bindir/RenderPlist"
	pq_staged="$bindir/pq"
	if [ ! -x "$staged" ] || [ ! -x "$render" ] || [ ! -x "$pq_staged" ]; then
		note "Swift build finished but one of paneru-swift/RenderPlist/pq is missing or not executable"
		return 1
	fi
	ok "Swift daemon built from local source"
	install_staged_swift "$staged" "$render" "$pq_staged"
}

# ─────────────────────────────────────────────────────────────
# Legacy cleanup: a pre-existing Rust daemon install (binary, service,
# app shim) must not fight the Swift daemon over windows/taps. Run on
# every install so a previous Rust-era setup is retired. TCC rows are
# left alone (revokes need FDA and fail noisily without it).
# ─────────────────────────────────────────────────────────────
remove_legacy_rust() {
	local rust_bin candidate plist
	if command -v paneru >/dev/null 2>&1; then
		note "Stopping legacy Rust daemon..."
		paneru stop >/dev/null 2>&1 || true
	fi
	rust_bin="$(command -v paneru 2>/dev/null || true)"
	if [ -n "$rust_bin" ] && [ -x "$rust_bin" ]; then
		"$rust_bin" uninstall >/dev/null 2>&1 || true
	fi
	plist="$HOME/Library/LaunchAgents/com.github.karinushka.paneru.plist"
	if [ -f "$plist" ]; then
		launchctl bootout "gui/$(id -u)/com.github.karinushka.paneru" >/dev/null 2>&1 || true
		rm -f "$plist"
		ok "Legacy Rust launchd service removed"
	fi
	for candidate in /opt/homebrew/bin/paneru /usr/local/bin/paneru "$HOME/.local/bin/paneru"; do
		if [ -f "$candidate" ]; then
			rm -f "$candidate" && ok "Removed legacy Rust binary $candidate"
		fi
	done
	if [ -n "${PANERU_BINDIR:-}" ] && [ -f "$PANERU_BINDIR/paneru" ]; then
		rm -f "$PANERU_BINDIR/paneru" && ok "Removed legacy Rust binary $PANERU_BINDIR/paneru"
	fi
	if [ -d "$HOME/Applications/Paneru.app" ]; then
		rm -rf "$HOME/Applications/Paneru.app"
		ok "Removed ~/Applications/Paneru.app (legacy Rust shim; Swift uses no shim)"
	fi
	hash -r 2>/dev/null || true
}

# ─────────────────────────────────────────────────────────────
# Dispatch: release by default; source build under --prefer-local-builds.
# ─────────────────────────────────────────────────────────────
if [ -n "${PREFER_LOCAL_BUILDS:-}" ]; then
	note "Local builds preferred — building from the sibling ../paneru-swift checkout."
	fetch_swift_local
	status=$?
	if [ "$status" -eq 1 ]; then
		warn "Local Swift build failed — aborting (no release fallback with --prefer-local-builds)."
		exit 1
	fi
	if [ "$status" -eq 2 ]; then
		# No sibling checkout — fall through to the release download.
		note "No sibling checkout — falling back to release download."
		if ! fetch_swift_release; then
			warn "paneru-swift release fetch failed for $PANERU_LABEL."
			warn "Check your network or set PANERU_TAG to a known tag, then re-run."
			exit 1
		fi
	fi
elif ! fetch_swift_release; then
	warn "paneru-swift release fetch failed for $PANERU_LABEL."
	warn "Check your network or set PANERU_TAG to a known tag, then re-run."
	warn "Or pass --prefer-local-builds to build from a sibling ../paneru-swift checkout."
	exit 1
fi

# Always retire a pre-existing Rust daemon so two tilers never fight.
if command -v paneru >/dev/null 2>&1 \
	|| [ -f "$HOME/Library/LaunchAgents/com.github.karinushka.paneru.plist" ] \
	|| [ -d "$HOME/Applications/Paneru.app" ]; then
	remove_legacy_rust
fi

# ─────────────────────────────────────────────────────────────
# Config (single init.lua — display navigation is native now, no lib/)
# ─────────────────────────────────────────────────────────────
mkdir -p ~/.config/paneru

if [ -f ~/.config/paneru/init.lua ]; then
	note "Existing config found at ~/.config/paneru/init.lua — backing up"
	cp ~/.config/paneru/init.lua ~/.config/paneru/init.lua.bak
fi

cp "$REPO_ROOT/config/paneru/init.lua" ~/.config/paneru/init.lua
# Stale Lua modules from the pre-fork workaround (displays.lua, query.lua,
# log.lua): the new config never requires them, so drop the whole dir.
rm -rf ~/.config/paneru/lib
ok "Paneru config installed to ~/.config/paneru/init.lua (stale lib/ removed)"
note "Menu-bar workspace indicator is off (upstream event-tap starvation bug, karinushka/paneru#390);"
note "the popup still shows the active workspace. Re-enable after a Paneru release ships the fix."
note "Cmd+Shift+? opens the shortcut cheat sheet via the helper above."

SWIFT_BIN_DONE="$(command -v paneru-swift 2>/dev/null || true)"
warn "Swift daemon will be started by enable-services after permissions are granted."
echo "     (grant Accessibility once to ${SWIFT_BIN_DONE:-paneru-swift} — the stable"
echo "      signing identity keeps it valid across updates; no remove/regrant needed)"
exit 0