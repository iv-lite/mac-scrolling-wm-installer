#!/usr/bin/env bash
set -euo pipefail

CYAN=$'\033[0;36m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
RESET=$'\033[0m'

note() { echo "  ${CYAN}→ $*${RESET}"; }
ok()   { echo "  ${GREEN}✓ $*${RESET}"; }
warn() { echo "  ${YELLOW}⚠ $*${RESET}"; }

# ─────────────────────────────────────────────────────────────
# AeroSpace (GUI app, self-managed login item via 'start-at-login')
# ─────────────────────────────────────────────────────────────
if [ -d /Applications/AeroSpace.app ]; then
	if pgrep -q -f "AeroSpace.app" 2>/dev/null; then
		ok "AeroSpace already running"
	else
		note "Starting AeroSpace..."
		open -a AeroSpace
		sleep 2
		if pgrep -q -f "AeroSpace.app" 2>/dev/null; then
			ok "AeroSpace running"
		else
			warn "AeroSpace failed to start — verify Accessibility permission was granted, then re-run: open -a AeroSpace"
		fi
	fi
fi

# ─────────────────────────────────────────────────────────────
# AeroSpaceBar (menu-bar companion)
# ─────────────────────────────────────────────────────────────
if [ -d /Applications/AeroSpaceBar.app ]; then
	note "Launching AeroSpaceBar..."
	open -a AeroSpaceBar 2>/dev/null || true
	ok "AeroSpaceBar launched (icon in the menu bar)"
fi

# ─────────────────────────────────────────────────────────────
# JankyBorders (brew services)
# ─────────────────────────────────────────────────────────────
if command -v borders >/dev/null 2>&1; then
	note "Starting JankyBorders..."
	brew services start borders >/dev/null 2>&1 || true
	ok "JankyBorders service started"
fi

echo ""
ok "Services enabled"