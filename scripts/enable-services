#!/usr/bin/env bash
set -euo pipefail

CYAN=$'\033[0;36m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
RESET=$'\033[0m'

note() { echo "  ${CYAN}→ $*${RESET}"; }
ok()   { echo "  ${GREEN}✓ $*${RESET}"; }
warn() { echo "  ${YELLOW}⚠ $*${RESET}"; }

LAUNCH_AGENT="$HOME/Library/LaunchAgents/dev.guria.nehir.plist"
LABEL="dev.guria.nehir"

# Resolve the app path — cask installs to /Applications, source to ~/Applications.
app_path() {
	if [ -d /Applications/Nehir.app ]; then
		echo "/Applications/Nehir.app"
	elif [ -d "$HOME/Applications/Nehir.app" ]; then
		echo "$HOME/Applications/Nehir.app"
	else
		echo ""
	fi
}

# ─────────────────────────────────────────────────────────────
# Nehir (launchd agent)
# ─────────────────────────────────────────────────────────────
if [ ! -f "$LAUNCH_AGENT" ]; then
	warn "No LaunchAgent at $LAUNCH_AGENT — run scripts/install-nehir first"
	exit 1
fi

APP_PATH="$(app_path)"
if [ -z "$APP_PATH" ]; then
	warn "Nehir.app not found at /Applications or ~/Applications — run scripts/install-nehir first"
	exit 1
fi

if pgrep -x Nehir >/dev/null 2>&1; then
	note "Restarting Nehir (applies upgraded binary)..."
	launchctl bootout "gui/$(id -u)/$LABEL" >/dev/null 2>&1 || pkill -x Nehir || true
	sleep 1
	launchctl bootstrap "gui/$(id -u)" "$LAUNCH_AGENT" 2>/dev/null \
		&& ok "Nehir relaunched via launchd" \
		|| warn "launchd bootstrap failed — grant Accessibility to Nehir, then run launchctl load $LAUNCH_AGENT"
else
	note "Launching Nehir..."
	launchctl bootstrap "gui/$(id -u)" "$LAUNCH_AGENT" 2>/dev/null \
		&& ok "Nehir service started" \
		|| warn "launchctl bootstrap failed — close Nehir if already running, then run: launchctl load $LAUNCH_AGENT"
fi

if ! pgrep -x Nehir >/dev/null 2>&1; then
	warn "Nehir is not running — grant Accessibility to Nehir (scripts/grant-permissions), then run: $0"
fi

echo ""
ok "Services enabled"