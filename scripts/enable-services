#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

CYAN=$'\033[0;36m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
RESET=$'\033[0m'

note() { echo "  ${CYAN}→ $*${RESET}"; }
ok()   { echo "  ${GREEN}✓ $*${RESET}"; }
warn() { echo "  ${YELLOW}⚠ $*${RESET}"; }

# ─────────────────────────────────────────────────────────────
# Paneru (per-user launchd service)
# ─────────────────────────────────────────────────────────────
if command -v paneru >/dev/null 2>&1; then
	if pgrep -qx paneru >/dev/null 2>&1; then
		note "Restarting Paneru (applies upgraded binary + config)..."
		if paneru restart >/dev/null 2>&1; then
			ok "Paneru restarted"
		else
			warn "Paneru restart failed — verify Accessibility permission, then run: paneru restart"
		fi
	else
		note "Starting Paneru..."
		if paneru start >/dev/null 2>&1; then
			ok "Paneru service started"
		else
			warn "Paneru failed to start — verify Accessibility permission was granted, then run: paneru start"
		fi
	fi
fi

# ─────────────────────────────────────────────────────────────
# Post-start health check: the daemon must answer state queries.
# A permission-less daemon (voided Accessibility grant after a binary
# swap) starts fine but never tiles — catch that here instead of
# leaving a silently broken setup behind.
# ─────────────────────────────────────────────────────────────
if command -v paneru >/dev/null 2>&1; then
	healthy=0
	for i in $(seq 1 10); do
		if paneru query state --json >/dev/null 2>&1; then
			healthy=1
			break
		fi
		sleep 1
	done
	if [ "$healthy" -eq 1 ]; then
		ok "Paneru answers state queries (daemon healthy)"
	else
		warn "Paneru is not answering state queries — attempting self-repair..."
		bash "$SCRIPT_DIR/repair-paneru"
	fi
fi

echo ""
ok "Services enabled"