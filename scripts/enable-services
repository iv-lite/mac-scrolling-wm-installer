#!/usr/bin/env bash
set -euo pipefail

CYAN=$'\033[0;36m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
RESET=$'\033[0m'

note() { echo "  ${CYAN}→ $*${RESET}"; }
ok()   { echo "  ${GREEN}✓ $*${RESET}"; }
warn() { echo "  ${YELLOW}⚠ $*${RESET}"; }

# ─────────────────────────────────────────────────────────────
# Nehir (plain menu-bar app — no launchd service the way Rift had one)
# ─────────────────────────────────────────────────────────────
if [ -d /Applications/Nehir.app ]; then
	if pgrep -qx Nehir >/dev/null 2>&1; then
		note "Relaunching Nehir (applies upgraded binary + refreshed config)..."
		killall Nehir >/dev/null 2>&1 || true
		sleep 1
		if open -a Nehir; then
			ok "Nehir relaunched"
		else
			warn "Nehir failed to relaunch — verify Accessibility permission, then run: open -a Nehir"
		fi
	else
		note "Starting Nehir..."
		if open -a Nehir; then
			ok "Nehir started"
		else
			warn "Nehir failed to start — verify Accessibility permission was granted, then run: open -a Nehir"
		fi
	fi
fi

# ─────────────────────────────────────────────────────────────
# JankyBorders (brew services)
# ─────────────────────────────────────────────────────────────
if command -v borders >/dev/null 2>&1; then
	if pgrep -qx borders >/dev/null 2>&1; then
		note "Restarting JankyBorders (applies upgraded binary + bordersrc)..."
		brew services restart borders >/dev/null 2>&1 || true
		ok "JankyBorders restarted"
	else
		note "Starting JankyBorders..."
		brew services start borders >/dev/null 2>&1 || true
		ok "JankyBorders service started"
	fi
fi

echo ""
ok "Services enabled"